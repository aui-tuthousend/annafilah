# Copy file ini ke .env (untuk `astro dev`) dan isi sesuai konfigurasi kamu.
# Untuk `wrangler dev` / `wrangler deploy`, gunakan .dev.vars.example
# (pilih salah satu saja: .env ATAU .dev.vars — jangan keduanya).

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Supabase)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/annafilah

# Di produksi (Cloudflare) DATABASE_URL tidak perlu diisi — koneksi memakai
# binding Hyperdrive. Lihat wrangler.jsonc.

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Secret untuk session cookie & endpoint /api/auth/seed
SESSION_SECRET=ganti-dengan-string-acak-panjang

# ─── Cloudflare R2 (S3-compatible) ────────────────────────────────────────────
S3_REGION=auto
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=annafilah
# URL publik bucket (custom domain atau r2.dev)
S3_PUBLIC_URL=https://media.annafilah.id
