---
// Hero Section – slider berita berfeature + gambar statis, loop tak terbatas
import { getFeaturedNews } from "../../pages/berita/-api/repository";

// Gambar statis yang selalu tampil di akhir slider (tanpa tautan)
const staticImages = [
    "https://s3.annafilah.id/hero/hero1.webp",
    "https://s3.annafilah.id/hero/hero2.webp",
    "https://s3.annafilah.id/hero/hero3.webp",
];

// Berita terbaru yang di-toggle dari halaman /berita (maksimal 3)
const featuredNews = await getFeaturedNews(3);

interface Slide {
    image: string;
    alt: string;
    title?: string;
    category?: string;
    slug?: string;
}

const slides: Slide[] = [
    ...featuredNews.map((item) => ({
        image: item.image,
        alt: item.title,
        title: item.title,
        category: item.category,
        slug: item.slug,
    })),
    ...staticImages.map((src) => ({
        image: src,
        alt: "Annafilah Hero Showcase",
    })),
];

// Salinan slide pertama di akhir untuk menyambung loop tanpa terlihat
const allSlides = [
    ...slides.map((slide) => ({ ...slide, isClone: false })),
    { ...slides[0], isClone: true },
];
---

<section id="hero" class="pt-5 pb-0 px-4 md:px-0 bg-slate-50">
    <!-- Image Slider -->
    <div
        class="max-w-[2000px] mx-auto overflow-hidden relative md:rounded-3xl shadow-2xl"
    >
        <div
            id="hero-carousel"
            class="flex transition-transform duration-1000 ease-in-out"
            style="transform: translateX(0%);"
        >
            {
                allSlides.map((slide, index) => (
                    <div
                        class={`hero-slide min-w-full relative aspect-[2.5/1] bg-slate-200 overflow-hidden ${slide.isClone ? "hero-clone" : ""}`}
                    >
                        {slide.slug ? (
                            <a
                                href={`/berita/${slide.slug}`}
                                class="group block w-full h-full"
                            >
                                <img
                                    src={slide.image}
                                    alt={slide.alt}
                                    class="w-full h-full object-cover select-none"
                                    loading={index === 0 ? "eager" : "lazy"}
                                />
                                <div class="absolute inset-0 bg-gradient-to-t from-slate-900/75 via-slate-900/15 to-transparent" />
                                <div class="absolute inset-x-0 bottom-0 p-5 md:p-10 flex flex-col items-start gap-3">
                                    <span class="px-3 py-1 rounded-full bg-teal-600 text-white text-xs font-semibold uppercase tracking-wider">
                                        {slide.category}
                                    </span>
                                    <h3 class="text-white text-xl md:text-3xl font-bold leading-tight max-w-3xl group-hover:text-teal-200 transition-colors">
                                        {slide.title}
                                    </h3>
                                </div>
                            </a>
                        ) : (
                            <>
                                <img
                                    src={slide.image}
                                    alt={slide.alt}
                                    class="w-full h-full object-cover select-none"
                                    loading={index === 0 ? "eager" : "lazy"}
                                />
                                <div class="absolute inset-0 bg-gradient-to-t from-slate-100/30 via-transparent to-transparent" />
                            </>
                        )}
                    </div>
                ))
            }
        </div>
    </div>
</section>

<script>
    function setupHeroCarousel() {
        const carousel = document.getElementById(
            "hero-carousel",
        ) as HTMLElement | null;

        if (!carousel) return;
        if (carousel.dataset.initialized === "true") return;
        carousel.dataset.initialized = "true";

        const track: HTMLElement = carousel;

        // Slide asli saja (clone di akhir tidak dihitung)
        const totalSlides = track.querySelectorAll(
            ".hero-slide:not(.hero-clone)",
        ).length;
        if (totalSlides < 2) return;

        let currentSlide: number = 0;
        let interval: ReturnType<typeof setInterval> | undefined;

        function updateSlide(index: number, animate: boolean = true) {
            currentSlide = index;
            track.style.transition = animate
                ? "transform 1000ms ease-in-out"
                : "none";
            track.style.transform = `translateX(-${currentSlide * 100}%)`;

            // Setelah sampai clone, lompat diam-diam ke slide pertama
            if (currentSlide === totalSlides) {
                setTimeout(() => {
                    currentSlide = 0;
                    track.style.transition = "none";
                    track.style.transform = `translateX(0%)`;
                }, 1000);
            }
        }

        function startInterval() {
            if (interval) clearInterval(interval);
            interval = setInterval(() => updateSlide(currentSlide + 1), 5000);
        }

        updateSlide(0, false);
        startInterval();
    }

    setupHeroCarousel();
    document.addEventListener("astro:after-swap", setupHeroCarousel);
</script>
