---
// About Section – ringkasan singkat tentang Yayasan Annafilah
const stats = [
    { value: "200+", label: "Klien" },
    { value: "8+", label: "Tahun Berdiri" },
    { value: "99%", label: "Kepuasan" },
];
---

<section id="tentang" class="py-20 bg-slate-900/50">
    <div class="max-w-7xl mx-auto px-6">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
            <!-- Left: Text -->
            <div>
                <p
                    class="text-indigo-400 font-semibold text-sm uppercase tracking-widest mb-4"
                >
                    Tentang Kami
                </p>
                <h2
                    class="text-4xl md:text-5xl font-extrabold text-white leading-tight mb-6"
                >
                    Yayasan Annafilah —<br />
                    <span class="text-indigo-400">Mitra Terpercaya</span> Bisnis Anda
                </h2>
                <p class="text-slate-300 text-lg leading-relaxed mb-5">
                    Annafilah hadir sebagai yayasan profesional yang berkomitmen
                    menjadi mitra jangka panjang bagi perusahaan dari berbagai
                    skala — dari startup hingga korporasi besar.
                </p>
                <p class="text-slate-400 leading-relaxed mb-8">
                    Berdiri selama lebih dari 8 tahun, kami telah melayani lebih
                    dari 200 klien aktif di seluruh Indonesia dengan semangat
                    dedikasi, integritas, dan inovasi yang tidak pernah berhenti
                    berkembang.
                </p>
            </div>

            <!-- Right: Image -->
            <div class="relative group">
                <!-- Decorative background blur -->
                <div
                    class="absolute -inset-4 bg-indigo-600/20 rounded-[2rem] blur-2xl group-hover:bg-indigo-600/30 transition-all duration-500"
                >
                </div>

                <div
                    class="relative overflow-hidden rounded-[2rem] border border-white/10 shadow-2xl"
                >
                    <img
                        src="/468739.webp"
                        alt="Aktivitas Yayasan Annafilah"
                        class="w-full aspect-[4/3] object-cover hover:scale-105 transition-transform duration-700"
                        loading="lazy"
                    />
                </div>
            </div>
        </div>

        <!-- Stats Bar -->
        <div
            class="mt-20 grid grid-cols-3 gap-4 md:gap-8 border-t border-white/5 pt-12"
        >
            {
                stats.map((stat, i) => (
                    <div
                        class={`text-center ${i === 1 ? "border-x border-white/5" : ""}`}
                    >
                        <p class="text-2xl md:text-4xl font-black text-white">
                            {stat.value}
                        </p>
                        <p class="text-xs md:text-sm text-slate-500 uppercase tracking-widest mt-1">
                            {stat.label}
                        </p>
                    </div>
                ))
            }
        </div>
    </div>
</section>
