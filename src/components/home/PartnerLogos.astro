---
const partners = [
    { name: "Daycare Bintang Kecil", logo: "/logos/bintangkecil.jpg" },
    { name: "Nurul Hayat", logo: "/logos/nh.jpg" },
    { name: "PLN", logo: "/logos/pln.png" },
    { name: "Pajak", logo: "/logos/djp.jpg" },
    { name: "Yatim Mandiri", logo: "/logos/ym.png" },
    { name: "Brownis Amanda", logo: "/logos/amanda.webp" },
    { name: "RSIA Cempaka Putih", logo: "/logos/rsia.webp" },
    { name: "mitramas infosys global", logo: "/logos/mig.png" },
    { name: "Asia Cahaya Teknik Prima", logo: "/logos/actp.jpg" },
    { name: "Coffee 57 Gresik", logo: "/logos/57.jpg" },
    { name: "swk gayungan", logo: "/logos/swk.jpg" },
];
---

<section class="py-12 bg-white overflow-hidden border-y border-slate-200">
    <div class="max-w-7xl mx-auto px-6 mb-8">
        <p
            class="text-center  text-sm font-semibold uppercase tracking-widest"
        >
            Mitra Kami
        </p>
    </div>

    <div class="marquee-wrapper">
        <div class="marquee-track">
            <!-- Original set -->
            {
                partners.map((p) => (
                    <div class="marquee-item">
                        <img
                            src={p.logo}
                            alt={p.name}
                            class="logo-img"
                            loading="lazy"
                        />
                    </div>
                ))
            }
            <!-- Duplicate set for seamless loop -->
            {
                partners.map((p) => (
                    <div class="marquee-item" aria-hidden="true">
                        <img
                            src={p.logo}
                            alt={p.name}
                            class="logo-img"
                            loading="lazy"
                        />
                    </div>
                ))
            }
        </div>
    </div>
</section>

<style>
    .marquee-wrapper {
        overflow: hidden;
        width: 100%;
    }

    .marquee-track {
        display: flex;
        width: max-content;
        animation: marquee 30s linear infinite;
    }

    .marquee-wrapper:hover .marquee-track {
        animation-play-state: paused;
    }

    .marquee-item {
        display: flex;
        align-items: center;
        padding: 0 2rem;
    }

    .logo-img {
        height: 70px;
        width: auto;
        object-fit: contain;
    }

    @keyframes marquee {
        0% {
            transform: translateX(0);
        }
        100% {
            transform: translateX(-50%);
        }
    }
</style>
