---
const partners = [
    { name: "Global Tech", icon: "🌐" },
    { name: "Eco Builders", icon: "🌱" },
    { name: "Future Finance", icon: "💰" },
    { name: "Smart Solutions", icon: "🧠" },
    { name: "Apex Design", icon: "🎨" },
    { name: "Data Core", icon: "💾" },
    { name: "Cloud Sync", icon: "☁️" },
    { name: "Nova Marketing", icon: "🚀" },
];
---

<section class="py-12 bg-slate-950 overflow-hidden border-y border-white/5">
    <div class="max-w-7xl mx-auto px-6 mb-8">
        <p
            class="text-center text-slate-400 text-sm font-semibold uppercase tracking-widest"
        >
            Mitra Kami
        </p>
    </div>

    <div class="flex relative">
        <!-- First row of logos -->
        <div class="flex space-x-12 animate-marquee whitespace-nowrap">
            {
                partners.map((p) => (
                    <div class="flex items-center space-x-3 grayscale opacity-50 hover:grayscale-0 hover:opacity-100 transition-all duration-300">
                        <span class="text-3xl">{p.icon}</span>
                        <span class="text-xl font-bold text-slate-300 tracking-tight">
                            {p.name}
                        </span>
                    </div>
                ))
            }
        </div>
        <!-- Duplicated row for seamless loop -->
        <div
            class="flex space-x-12 animate-marquee whitespace-nowrap ml-12"
            aria-hidden="true"
        >
            {
                partners.map((p) => (
                    <div class="flex items-center space-x-3 grayscale opacity-50 hover:grayscale-0 hover:opacity-100 transition-all duration-300">
                        <span class="text-3xl">{p.icon}</span>
                        <span class="text-xl font-bold text-slate-300 tracking-tight">
                            {p.name}
                        </span>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<style>
    @keyframes marquee {
        0% {
            transform: translateX(0);
        }
        100% {
            transform: translateX(-100%);
        }
    }

    .animate-marquee {
        animation: marquee 30s linear infinite;
    }

    /* Pause on hover for better UX */
    .flex:hover .animate-marquee {
        animation-play-state: paused;
    }
</style>
