---
import Layout from "../../layouts/Layout.astro";
---

<Layout
    title="Program – Annafilah"
    description="Temukan program Annafilah yang tepat untuk kebutuhan bisnis Anda."
>
    <section class="pt-32 pb-24 max-w-7xl mx-auto px-6">
        <div class="text-center mb-16">
            <p
                class="text-indigo-400 font-semibold text-sm uppercase tracking-widest mb-3"
            >
                Apa yang Kami Tawarkan
            </p>
            <h1 class="text-5xl font-extrabold text-white mb-4">
                Semua Program
            </h1>
            <p class="text-slate-400 text-lg max-w-xl mx-auto">
                Pilih program yang sesuai dengan tahap dan kebutuhan bisnis Anda
                saat ini.
            </p>
        </div>
    </section>
</Layout>