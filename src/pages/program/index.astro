---
import Layout from "../../layouts/Layout.astro";
import { getAllPrograms } from "./-api/repository";

export const prerender = false;

const programsList = await getAllPrograms({ isPublished: true, limit: 100 });

// AUTH: Ambil status login dari context.locals (optimal: tanpa query DB tambahan)
const isLoggedIn = !!Astro.locals.username;
---

<Layout
    title="Program Yayasan Annafilah"
    description="Program-program unggulan Yayasan Annafilah dalam mewujudkan visi misi yayasan."
>
    <section class="pt-32 pb-24 bg-slate-50 px-6">
        <div class="max-w-7xl mx-auto">
            <!-- Header -->
            <div class="mb-16">
                <nav
                    class="text-sm text-slate-500 mb-6 flex items-center gap-2"
                >
                    <a href="/" class="hover:text-teal-600 transition-colors"
                        >Beranda</a
                    >
                    <span>/</span>
                    <span class="text-slate-300">Program</span>
                </nav>

                <div class="flex items-center justify-between gap-4 flex-wrap">
                    <div>
                        <p
                            class="text-teal-600 font-semibold text-sm uppercase tracking-widest mb-3"
                        >
                            Program Unggulan
                        </p>
                        <h1 class="text-5xl font-extrabold text-slate-900 mb-4">
                            Program-Program Yayasan Annafilah
                        </h1>
                        <p class="text-slate-600 text-lg max-w-xl">
                            Program-program unggulan Yayasan Annafilah dalam
                            mewujudkan visi misi yayasan.
                        </p>
                    </div>
                    {
                        isLoggedIn && (
                            <a
                                href="/program/create"
                                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-teal-600 hover:bg-teal-500 text-white font-semibold text-sm transition-all duration-200 hover:shadow-lg hover:shadow-teal-500/25 shrink-0"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="w-4 h-4"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M12 4v16m8-8H4"
                                    />
                                </svg>
                                Tambah Program
                            </a>
                        )
                    }
                </div>
            </div>

            <!-- Programs Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {
                    programsList.length > 0 ? (
                        programsList.map((program) => (
                            <a
                                href={`/program/${program.slug}`}
                                class="group block border border-slate-200 rounded-2xl overflow-hidden bg-white hover:border-teal-400/50 hover:-translate-y-1 transition-all duration-300 shadow-sm"
                            >
                                <div class="relative aspect-[16/9] overflow-hidden bg-slate-200">
                                    <img
                                        src={program.image}
                                        alt={program.name}
                                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                        loading="lazy"
                                    />
                                    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-transparent to-transparent" />

                                    {isLoggedIn && (
                                        <div class="absolute top-4 right-4 flex gap-2">
                                            <button
                                                onclick={`event.preventDefault(); event.stopPropagation(); window.location.href='/program/edit/${program.slug}'`}
                                                class="p-2 rounded-lg bg-white/80 text-slate-700 hover:text-teal-600 border border-slate-200 hover:border-teal-400/50 backdrop-blur-sm transition-all"
                                                title="Edit Program"
                                            >
                                                <svg
                                                    xmlns="http://www.w3.org/2000/svg"
                                                    class="w-4 h-4"
                                                    fill="none"
                                                    viewBox="0 0 24 24"
                                                    stroke="currentColor"
                                                >
                                                    <path
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"
                                                    />
                                                </svg>
                                            </button>
                                            <button
                                                onclick={`event.preventDefault(); event.stopPropagation(); if(confirm('Hapus program ini?')){ fetch('/api/program/${program.id}', {method:'DELETE'}).then(r => r.json()).then(res => { if(res.success) window.location.reload(); else alert(res.error); }) }`}
                                                class="p-2 rounded-lg bg-red-500/20 text-red-400 hover:bg-red-500 hover:text-white border border-red-500/30 backdrop-blur-sm transition-all"
                                                title="Hapus Program"
                                            >
                                                <svg
                                                    xmlns="http://www.w3.org/2000/svg"
                                                    class="w-4 h-4"
                                                    fill="none"
                                                    viewBox="0 0 24 24"
                                                    stroke="currentColor"
                                                >
                                                    <path
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                                                    />
                                                </svg>
                                            </button>
                                        </div>
                                    )}
                                </div>
                                <div class="p-6">
                                    <h2 class="text-slate-900 font-bold text-xl group-hover:text-teal-600 transition-colors leading-snug mb-3">
                                        {program.name}
                                    </h2>
                                    <span class="inline-flex items-center gap-1 text-teal-600 text-sm font-semibold group-hover:gap-2 transition-all">
                                        Lihat Program
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            class="w-4 h-4"
                                            fill="none"
                                            viewBox="0 0 24 24"
                                            stroke="currentColor"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M9 5l7 7-7 7"
                                            />
                                        </svg>
                                    </span>
                                </div>
                            </a>
                        ))
                    ) : (
                        <div class="col-span-full py-20 text-center">
                            <p class="text-slate-500 text-lg">
                                Belum ada program yang tersedia.
                            </p>
                        </div>
                    )
                }
            </div>
        </div>
    </section>
</Layout>
