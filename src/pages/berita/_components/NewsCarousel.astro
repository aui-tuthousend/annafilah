---
import { getAllNews } from "../-api/repository";
import NewsCard from "./NewsCard.astro";

const newsItems = await getAllNews({ isPublished: true, limit: 6 });

const DESKTOP_PER_PAGE = 3;
const totalPages = Math.ceil(newsItems.length / DESKTOP_PER_PAGE);

// Helper to format date
const formatDate = (date: Date) => {
    return new Intl.DateTimeFormat("id-ID", {
        day: "numeric",
        month: "long",
        year: "numeric",
    }).format(date);
};
---

<section id="berita" class="py-24 bg-slate-100">
    <div class="max-w-7xl mx-auto px-6">
        <!-- Section Header -->
        <div class="flex items-end justify-between mb-12">
            <div>
                <p
                    class="text-teal-600 font-semibold text-sm uppercase tracking-widest mb-3"
                >
                    Terbaru
                </p>
                <h2 class="text-4xl md:text-5xl font-extrabold text-slate-900">
                    Berita & Update
                </h2>
            </div>
            <a
                href="/berita"
                class="hidden md:inline-flex items-center gap-2 text-slate-500 hover:text-teal-600 text-sm font-semibold transition-colors"
            >
                Lihat Semua
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-4 h-4"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 5l7 7-7 7"></path>
                </svg>
            </a>
        </div>

        <!-- Carousel Viewport -->
        <div class="relative overflow-hidden">
            <div
                id="news-track"
                class="flex gap-4 transition-transform duration-700 ease-in-out"
                style="transform: translateX(0%);"
            >
                {
                    newsItems.length > 0 ? (
                        newsItems.map((item) => (
                            <NewsCard
                                title={item.title}
                                excerpt={item.excerpt}
                                category={item.category}
                                date={formatDate(item.createdAt)}
                                image={item.image}
                                slug={item.slug}
                            />
                        ))
                    ) : (
                        <div class="w-full py-10 text-center text-slate-500">
                            Belum ada berita terbaru.
                        </div>
                    )
                }
            </div>
        </div>

        <!-- Controls -->
        {
            newsItems.length > 0 && (
                <div class="flex items-center justify-between mt-10">
                    <!-- Dots -->
                    <div class="flex gap-2">
                        {Array.from({ length: totalPages }).map((_, i) => (
                            <button
                                class={`news-dot h-2 rounded-full transition-all duration-300 ${i === 0 ? "w-8 bg-teal-500" : "w-2 bg-slate-300"}`}
                                data-index={i}
                                aria-label={`Halaman berita ${i + 1}`}
                            />
                        ))}
                    </div>

                    <!-- Arrows -->
                    <div class="flex gap-3">
                        <button
                            id="news-prev"
                            class="w-11 h-11 rounded-full border border-slate-200 bg-slate-50 hover:bg-teal-600 hover:border-teal-600 text-slate-700 hover:text-white flex items-center justify-center transition-all duration-200 disabled:opacity-30 disabled:cursor-not-allowed"
                            aria-label="Sebelumnya"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="w-5 h-5"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M15 19l-7-7 7-7"
                                />
                            </svg>
                        </button>
                        <button
                            id="news-next"
                            class="w-11 h-11 rounded-full border border-slate-200 bg-slate-50 hover:bg-teal-600 hover:border-teal-600 text-slate-700 hover:text-white flex items-center justify-center transition-all duration-200"
                            aria-label="Selanjutnya"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="w-5 h-5"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M9 5l7 7-7 7"
                                />
                            </svg>
                        </button>
                    </div>
                </div>
            )
        }
    </div>
</section>

<script>
    function setupNewsCarousel() {
        const track = document.getElementById(
            "news-track",
        ) as HTMLElement | null;
        const prevBtn = document.getElementById(
            "news-prev",
        ) as HTMLButtonElement | null;
        const nextBtn = document.getElementById(
            "news-next",
        ) as HTMLButtonElement | null;
        const dots = document.querySelectorAll<HTMLButtonElement>(".news-dot");
        const cards = document.querySelectorAll<HTMLElement>(".news-card");

        if (!track || !cards.length) return;

        const isDesktop = () => window.innerWidth >= 1024;
        const isTablet = () => window.innerWidth >= 768 && window.innerWidth < 1024;
        const perPage = () => {
            if (isDesktop()) return 3;
            if (isTablet()) return 2;
            return 1;
        };
        const totalCards = cards.length;
        let current = 0;

        function maxPage() {
            return Math.max(0, totalCards - perPage());
        }

        function getCardWidth() {
            return cards[0].offsetWidth + 16; // card width + gap-4 (16px)
        }

        function goTo(index: number) {
            if (!track) return;
            current = Math.max(0, Math.min(index, maxPage()));
            track.style.transform = `translateX(-${current * getCardWidth()}px)`;

            const dotIndex = Math.floor(current / perPage());
            dots.forEach((dot, i) => {
                dot.classList.toggle("w-8", i === dotIndex);
                dot.classList.toggle("w-2", i !== dotIndex);
                dot.classList.toggle("bg-teal-500", i === dotIndex);
                dot.classList.toggle("bg-slate-300", i !== dotIndex);
            });

            if (prevBtn) prevBtn.disabled = current === 0;
            if (nextBtn) nextBtn.disabled = current >= maxPage();
        }

        prevBtn?.addEventListener("click", () => goTo(current - 1));
        nextBtn?.addEventListener("click", () => goTo(current + 1));
        dots.forEach((dot) => {
            dot.addEventListener("click", () => {
                const pageIndex = parseInt(dot.dataset.index ?? "0");
                goTo(pageIndex * perPage());
            });
        });

        window.addEventListener("resize", () => goTo(0));
        goTo(0);
    }

    setupNewsCarousel();
    document.addEventListener("astro:after-swap", setupNewsCarousel);
</script>
