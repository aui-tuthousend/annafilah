---
import Layout from "../../layouts/Layout.astro";
import NewsCardSmall from "./-components/NewsCardSmall.astro";
import { getAllNews } from "./-api/repository";

export const prerender = false;

const news = await getAllNews({ isPublished: true, limit: 100 });
const categories = ["Semua", ...new Set(news.map((n) => n.category))];

// AUTH: Ambil status login dari context.locals (optimal: tanpa query DB tambahan)
const isLoggedIn = !!Astro.locals.username;

// Helper to format date for the UI
const formatDate = (date: Date) => {
    return new Intl.DateTimeFormat("id-ID", {
        day: "numeric",
        month: "long",
        year: "numeric",
    }).format(date);
};
---

<Layout
    title="Berita & Update – Yayasan Annafilah"
    description="Jangan lewatkan berita kegiatan terbaru Yayasan Annafilah: kemitraan, penghargaan, event, dan berbagai kegiatan kami."
>
    <!-- Page Header -->
    <section class="pt-36 pb-12 bg-slate-50 px-6">
        <div class="max-w-7xl mx-auto">
            <!-- Breadcrumb -->
            <nav class="text-sm text-slate-500 mb-6 flex items-center gap-2">
                <a href="/" class="hover:text-teal-600 transition-colors"
                    >Beranda</a
                >
                <span>/</span>
                <span class="text-slate-300">Berita</span>
            </nav>

            <div
                class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-6"
            >
                <div>
                    <p
                        class="text-teal-600 font-semibold text-sm uppercase tracking-widest mb-3"
                    >
                        Terbaru
                    </p>
                    <h1
                        class="text-4xl md:text-5xl font-extrabold text-slate-900"
                    >
                        Berita & Update
                    </h1>
                </div>
                {
                    isLoggedIn && (
                        <a
                            href="/berita/create"
                            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-teal-600 hover:bg-teal-500 text-white text-sm font-bold transition-all duration-200 hover:shadow-lg hover:shadow-teal-500/25 shrink-0"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="w-4 h-4"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M12 4v16m8-8H4"
                                />
                            </svg>
                            Tambah Berita
                        </a>
                    )
                }
            </div>
            <p class="text-slate-600 text-lg max-w-2xl">
                Ikuti perkembangan terbaru kegiatan, kemitraan, dan pencapaian
                Yayasan Annafilah.
            </p>
        </div>
    </section>

    <!-- Divider -->
    <div class="border-t border-slate-200 bg-slate-50"></div>

    <!-- Filter + Grid -->
    <section class="py-16 px-6 bg-slate-50 min-h-screen">
        <div class="max-w-7xl mx-auto">
            <!-- Category Filter -->
            <div class="flex flex-wrap gap-2 mb-10" id="filter-bar">
                {
                    categories.map((cat, i) => (
                        <button
                            class={`filter-btn px-4 py-1.5 rounded-full text-sm font-medium border transition-all duration-200 ${
                                i === 0
                                    ? "bg-teal-600 border-teal-600 text-white"
                                    : "bg-transparent border-slate-200 text-slate-500 hover:border-teal-400/50 hover:text-slate-900"
                            }`}
                            data-filter={cat}
                        >
                            {cat}
                        </button>
                    ))
                }
            </div>

            <!-- News Grid -->
            <div
                id="news-grid"
                class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-5"
            >
                {
                    news.map((item) => (
                        <div class="news-item" data-category={item.category}>
                            <NewsCardSmall
                                title={item.title}
                                date={formatDate(item.createdAt)}
                                location={item.location}
                                image={item.image}
                                category={item.category}
                                slug={item.slug}
                                id={item.id}
                                isLoggedIn={isLoggedIn}
                            />
                        </div>
                    ))
                }
            </div>

            <!-- Empty State -->
            <div
                id="empty-state"
                class={`text-center py-24 text-slate-500 ${news.length > 0 ? "hidden" : ""}`}
            >
                <p class="text-4xl mb-4">📭</p>
                <p class="text-lg font-medium text-slate-400">
                    {
                        news.length === 0
                            ? "Belum ada berita yang diterbitkan."
                            : "Tidak ada berita di kategori ini."
                    }
                </p>
            </div>
        </div>
    </section>
</Layout>

<script>
    function setupFilter() {
        const buttons =
            document.querySelectorAll<HTMLButtonElement>(".filter-btn");
        const items = document.querySelectorAll<HTMLElement>(".news-item");
        const emptyState = document.getElementById("empty-state");

        buttons.forEach((btn) => {
            btn.addEventListener("click", () => {
                const filter = btn.dataset.filter ?? "Semua";

                // Update active button style
                buttons.forEach((b) => {
                    b.classList.remove(
                        "bg-teal-600",
                        "border-teal-600",
                        "text-white",
                    );
                    b.classList.add(
                        "bg-transparent",
                        "border-slate-200",
                        "text-slate-500",
                    );
                });
                btn.classList.add(
                    "bg-teal-600",
                    "border-teal-600",
                    "text-white",
                );
                btn.classList.remove(
                    "bg-transparent",
                    "border-slate-200",
                    "text-slate-500",
                );

                // Filter items
                let visible = 0;
                items.forEach((item) => {
                    const match =
                        filter === "Semua" || item.dataset.category === filter;
                    item.style.display = match ? "" : "none";
                    if (match) visible++;
                });

                // Show/hide empty state
                if (emptyState) {
                    emptyState.classList.toggle("hidden", visible > 0);
                }
            });
        });
    }

    setupFilter();
    document.addEventListener("astro:after-swap", setupFilter);
</script>
