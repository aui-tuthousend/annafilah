---
import Layout from "../../layouts/Layout.astro";
import { allNews, getNewsBySlug } from "../../data/news";
import type { NewsItem } from "../../data/news";

// ─── Static Path Generation ──────────────────────────────────────────────────
export function getStaticPaths() {
    return allNews.map((item) => ({
        params: { slug: item.slug },
    }));
}

// ─── Props ───────────────────────────────────────────────────────────────────
const { slug } = Astro.params;
const news = getNewsBySlug(slug as string);

if (!news) {
    return Astro.redirect("/berita");
}

// Related articles (same category, exclude current)
const related = allNews
    .filter((n) => n.category === news.category && n.slug !== news.slug)
    .slice(0, 3);
---

<Layout
    title={`${news.title} – Yayasan Annafilah`}
    description={news.excerpt}
    ogImage={news.image}
>
    <!-- Hero Image -->
    <div
        class="relative w-full aspect-[2.5/1] md:aspect-[3/1] overflow-hidden bg-slate-900 mt-0"
    >
        <img
            src={news.image}
            alt={news.title}
            class="w-full h-full object-cover"
            loading="eager"
        />
        <div
            class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/60 to-transparent"
        >
        </div>

        <!-- Title Overlay -->
        <div class="absolute bottom-0 left-0 right-0 pb-10 px-6">
            <div class="max-w-4xl mx-auto">
                <span
                    class="inline-block px-3 py-1 rounded-full bg-indigo-600/90 text-white text-xs font-semibold uppercase tracking-widest mb-4"
                >
                    {news.category}
                </span>
                <h1
                    class="text-3xl md:text-5xl font-extrabold text-white leading-tight"
                >
                    {news.title}
                </h1>
            </div>
        </div>
    </div>

    <!-- Article Body -->
    <article class="py-16 px-6 bg-slate-950">
        <div class="max-w-4xl mx-auto">
            <!-- Meta info -->
            <div
                class="flex flex-wrap items-center gap-4 text-sm text-slate-400 mb-10 pb-8 border-b border-white/5"
            >
                <!-- Breadcrumb -->
                <nav
                    class="w-full flex items-center gap-2 text-xs text-slate-500 mb-2"
                >
                    <a href="/" class="hover:text-indigo-400 transition-colors"
                        >Beranda</a
                    >
                    <span>/</span>
                    <a
                        href="/berita"
                        class="hover:text-indigo-400 transition-colors"
                        >Berita</a
                    >
                    <span>/</span>
                    <span class="text-slate-300 truncate max-w-xs"
                        >{news.title}</span
                    >
                </nav>
                <span class="flex items-center gap-1.5">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-4 h-4"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                        ></path>
                    </svg>
                    {news.date}
                </span>
                <span class="flex items-center gap-1.5">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-4 h-4"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                        ></path>
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                    {news.location}
                </span>
            </div>

            <!-- Excerpt -->
            <p class="text-slate-300 text-xl leading-relaxed mb-8 font-light">
                {news.excerpt}
            </p>

            <!-- Main content -->
            <div
                class="prose prose-invert prose-lg max-w-none prose-p:text-slate-400 prose-p:leading-relaxed prose-headings:text-white"
                set:html={news.content}
            />

            <!-- Back button -->
            <div class="mt-16 pt-8 border-t border-white/5">
                <a
                    href="/berita"
                    class="inline-flex items-center gap-2 text-indigo-400 font-semibold hover:text-indigo-300 transition-colors"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-4 h-4"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M15 19l-7-7 7-7"></path>
                    </svg>
                    Kembali ke Berita
                </a>
            </div>
        </div>
    </article>

    <!-- Related Articles -->
    {
        related.length > 0 && (
            <section class="py-16 px-6 bg-slate-900/50">
                <div class="max-w-4xl mx-auto">
                    <h2 class="text-2xl font-bold text-white mb-8">
                        Berita Terkait
                    </h2>
                    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-5">
                        {related.map((item) => (
                            <a
                                href={`/berita/${item.slug}`}
                                class="group block bg-slate-900 border border-white/5 rounded-xl overflow-hidden hover:border-indigo-500/30 hover:-translate-y-1 transition-all duration-300"
                            >
                                <div class="relative aspect-[16/9] overflow-hidden bg-slate-800">
                                    <img
                                        src={item.image}
                                        alt={item.title}
                                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                        loading="lazy"
                                    />
                                </div>
                                <div class="p-4">
                                    <span class="text-indigo-400 text-xs font-semibold uppercase tracking-wider">
                                        {item.category}
                                    </span>
                                    <h3 class="text-white font-semibold text-sm leading-snug line-clamp-2 mt-1 group-hover:text-indigo-300 transition-colors">
                                        {item.title}
                                    </h3>
                                    <p class="text-slate-500 text-xs mt-2">
                                        {item.date}
                                    </p>
                                </div>
                            </a>
                        ))}
                    </div>
                </div>
            </section>
        )
    }
</Layout>
