---
import Layout from "../../../layouts/Layout.astro";
import { getNewsBySlugAdmin } from "../-api/repository";
import { getAllPrograms } from "../../program/-api/repository";

export const prerender = false;

const { slug } = Astro.params;

if (!slug) {
    return Astro.redirect("/berita");
}

const [newsItem, allPrograms] = await Promise.all([
    getNewsBySlugAdmin(slug),
    getAllPrograms({ isPublished: true, limit: 100 }),
]);

if (!newsItem) {
    return Astro.redirect("/404");
}

const categories = ["Event", "Pencapaian", "Kemitraan", "CSR", "Internal"];
---

<Layout
    title={`Edit Berita: ${newsItem.title} – Yayasan Annafilah`}
    description={`Form untuk mengedit berita "${newsItem.title}" di Yayasan Annafilah.`}
>
    <div class="min-h-screen bg-slate-50 pt-28 pb-20 px-6">
        <div class="max-w-3xl mx-auto">
            <!-- Header -->
            <div class="mb-10">
                <nav
                    class="text-sm text-slate-500 mb-6 flex items-center gap-2"
                >
                    <a href="/" class="hover:text-teal-600 transition-colors"
                        >Beranda</a
                    >
                    <span>/</span>
                    <a
                        href="/berita"
                        class="hover:text-teal-600 transition-colors">Berita</a
                    >
                    <span>/</span>
                    <span class="text-slate-300">Edit Berita</span>
                </nav>
                <p
                    class="text-teal-600 font-semibold text-sm uppercase tracking-widest mb-2"
                >
                    Manajemen Konten
                </p>
                <h1 class="text-4xl font-extrabold text-slate-900">
                    Edit Berita
                </h1>
                <p class="text-slate-500 mt-2">
                    Perbarui informasi berita di bawah ini.
                </p>
            </div>

            <!-- Alert area -->
            <div
                id="form-alert"
                class="hidden mb-6 p-4 rounded-xl text-sm font-medium"
            >
            </div>

            <!-- Form -->
            <form
                id="edit-berita-form"
                novalidate
                class="space-y-6"
                data-id={newsItem.id}
            >
                <!-- Title -->
                <div class="form-group">
                    <label for="title" class="form-label">
                        Judul Berita <span class="text-red-400">*</span>
                    </label>
                    <input
                        type="text"
                        id="title"
                        name="title"
                        required
                        maxlength="100"
                        value={newsItem.title}
                        placeholder="Tulis judul berita yang menarik..."
                        class="form-input"
                    />
                    <p class="form-hint text-right">
                        <span id="title-count">{newsItem.title.length}</span
                        >/100
                    </p>
                </div>

                <!-- Slug Preview -->
                <div class="form-group">
                    <label for="slug-preview" class="form-label">
                        Slug URL
                        <span class="text-slate-500 font-normal text-xs ml-2"
                            >(otomatis dari judul)</span
                        >
                    </label>
                    <div
                        class="flex items-center gap-2 px-4 py-3 rounded-xl bg-slate-100 border border-slate-200 text-slate-500 text-sm"
                    >
                        <span class="text-slate-400 shrink-0">/berita/</span>
                        <span
                            id="slug-preview"
                            class="text-teal-700 font-mono font-medium break-all"
                            >{newsItem.slug}</span
                        >
                    </div>
                </div>

                <!-- Excerpt -->
                <div class="form-group">
                    <label for="excerpt" class="form-label">
                        Ringkasan <span class="text-red-400">*</span>
                        <span class="text-slate-500 font-normal text-xs ml-2"
                            >(ditampilkan di listing)</span
                        >
                    </label>
                    <textarea
                        id="excerpt"
                        name="excerpt"
                        required
                        maxlength="300"
                        rows="3"
                        placeholder="Tuliskan ringkasan singkat berita ini..."
                        class="form-input resize-none"
                        >{newsItem.excerpt}</textarea
                    >
                    <p class="form-hint text-right">
                        <span id="excerpt-count">{newsItem.excerpt.length}</span
                        >/300
                    </p>
                </div>

                <!-- Category + Location -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    <div class="form-group">
                        <label for="category" class="form-label">
                            Kategori <span class="text-red-400">*</span>
                        </label>
                        <select
                            id="category"
                            name="category"
                            required
                            class="form-input"
                        >
                            <option value="" disabled>Pilih kategori...</option>
                            {
                                categories.map((cat) => (
                                    <option
                                        value={cat}
                                        selected={newsItem.category === cat}
                                    >
                                        {cat}
                                    </option>
                                ))
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="location" class="form-label">
                            Lokasi <span class="text-red-400">*</span>
                        </label>
                        <input
                            type="text"
                            id="location"
                            name="location"
                            required
                            value={newsItem.location}
                            placeholder="Lokasi kegiatan..."
                            class="form-input"
                        />
                    </div>
                </div>

                <!-- Author + Program -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    <div class="form-group">
                        <label for="author" class="form-label">
                            Penulis <span class="text-red-400">*</span>
                        </label>
                        <input
                            type="text"
                            id="author"
                            name="author"
                            required
                            value={newsItem.author}
                            placeholder="Nama penulis..."
                            class="form-input"
                        />
                    </div>
                    <div class="form-group">
                        <label for="programId" class="form-label">
                            Program Terkait
                            <span
                                class="text-slate-500 font-normal text-xs ml-2"
                                >(opsional)</span
                            >
                        </label>
                        <select
                            id="programId"
                            name="programId"
                            class="form-input"
                        >
                            <option value="">Tidak ada program</option>
                            {
                                allPrograms.map((prog) => (
                                    <option
                                        value={prog.id}
                                        selected={
                                            newsItem.programId === prog.id
                                        }
                                    >
                                        {prog.name}
                                    </option>
                                ))
                            }
                        </select>
                    </div>
                </div>

                <!-- Gallery Management -->
                <div class="form-group">
                    <label class="form-label">
                        Galeri Gambar Berita <span class="text-red-400">*</span>
                        <span class="text-slate-500 font-normal text-xs ml-2"
                            >(Maksimal 2MB per foto. Gambar pertama akan menjadi
                            Cover)</span
                        >
                    </label>

                    <div
                        id="gallery-container"
                        class="grid grid-cols-2 sm:grid-cols-3 gap-4 p-4 rounded-2xl bg-slate-100 border border-slate-200"
                    >
                        {
                            newsItem.images.map((url, index) => (
                                <div
                                    class="gallery-item relative aspect-video group"
                                    data-url={url}
                                    data-type="existing"
                                >
                                    <img
                                        src={url}
                                        class="w-full h-full object-cover rounded-xl border border-white/10"
                                    />
                                    <div class="absolute inset-0 bg-slate-950/40 opacity-0 group-hover:opacity-100 transition-opacity rounded-xl flex items-center justify-center gap-2">
                                        <button
                                            type="button"
                                            class="btn-remove-gallery p-1.5 rounded-lg bg-red-500 text-white hover:bg-red-400 shadow-lg"
                                            title="Hapus Gambar"
                                        >
                                            <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                class="w-4 h-4"
                                                fill="none"
                                                viewBox="0 0 24 24"
                                                stroke="currentColor"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="2"
                                                    d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                                                />
                                            </svg>
                                        </button>
                                    </div>
                                    {index === 0 && (
                                        <div class="absolute top-2 left-2 px-2 py-0.5 rounded-md bg-teal-600 text-[10px] font-bold text-white uppercase tracking-wider">
                                            Cover
                                        </div>
                                    )}
                                </div>
                            ))
                        }

                        <!-- Add Button -->
                        <button
                            type="button"
                            id="btn-add-gallery"
                            class="aspect-video rounded-xl border-2 border-dashed border-slate-300 hover:border-teal-500/50 hover:bg-teal-50/20 flex flex-col items-center justify-center gap-2 text-slate-500 hover:text-teal-600 transition-all"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="w-6 h-6"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M12 4v16m8-8H4"></path>
                            </svg>
                            <span class="text-xs font-semibold"
                                >Tambah Foto</span
                            >
                        </button>
                        <input
                            type="file"
                            id="new-images-input"
                            multiple
                            accept="image/*"
                            class="sr-only"
                        />
                    </div>
                </div>

                <!-- Content -->
                <div class="form-group">
                    <label for="content" class="form-label">
                        Konten Berita <span class="text-red-400">*</span>
                        <span class="text-slate-500 font-normal text-xs ml-2"
                            >(mendukung HTML)</span
                        >
                    </label>

                    <div
                        class="flex flex-wrap items-center gap-1.5 p-2 rounded-xl bg-slate-100 border border-slate-200 mb-1"
                    >
                        <button
                            type="button"
                            class="html-tag-btn"
                            data-tag="p"
                            title="Paragraph (Alinea Baru)">P</button
                        >
                        <button
                            type="button"
                            class="html-tag-btn"
                            data-tag="br"
                            title="Line Break (Garis Baru)">BR</button
                        >
                        <div class="w-px h-4 bg-slate-300 mx-1"></div>
                        <button
                            type="button"
                            class="html-tag-btn font-bold"
                            data-tag="strong"
                            title="Bold (Tebal)">B</button
                        >
                        <button
                            type="button"
                            class="html-tag-btn italic"
                            data-tag="em"
                            title="Italic (Miring)">I</button
                        >
                        <button
                            type="button"
                            class="html-tag-btn underline"
                            data-tag="u"
                            title="Underline (Garis Bawah)">U</button
                        >
                        <div class="w-px h-4 bg-slate-300 mx-1"></div>
                        <button
                            type="button"
                            class="html-tag-btn"
                            data-tag="h3"
                            title="Heading 3 (Sub-judul)">H3</button
                        >
                        <button
                            type="button"
                            class="html-tag-btn"
                            data-tag="ul"
                            title="Unordered List (Daftar)">UL</button
                        >
                        <button
                            type="button"
                            class="html-tag-btn"
                            data-tag="li"
                            title="List Item (Poin Daftar)">LI</button
                        >
                        <button
                            type="button"
                            class="html-tag-btn text-lg leading-none"
                            data-tag="blockquote"
                            title="Quote (Kutipan)">“</button
                        >
                        <button
                            type="button"
                            class="html-tag-btn"
                            data-tag="a"
                            title="Link (Tautan)">Link</button
                        >
                    </div>

                    <textarea
                        id="content"
                        name="content"
                        required
                        rows="16"
                        placeholder="Tulis konten berita di sini..."
                        class="form-input resize-y font-mono text-sm"
                        >{newsItem.content}</textarea
                    >
                </div>

                <!-- Action Buttons -->
                <div class="flex gap-4 pt-2">
                    <button
                        type="submit"
                        id="btn-submit"
                        class="flex-1 flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-teal-600 hover:bg-teal-500 text-white font-semibold text-base transition-all duration-200 hover:shadow-lg hover:shadow-teal-500/25 disabled:opacity-50"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="w-5 h-5"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M5 13l4 4L19 7"></path>
                        </svg>
                        <span id="btn-submit-text">Simpan Perubahan</span>
                    </button>
                    <a
                        href="/berita"
                        class="px-6 py-3.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-600 font-semibold text-base transition-colors"
                    >
                        Batal
                    </a>
                </div>
            </form>
        </div>
    </div>
</Layout>

<style>
    @reference "../../../styles/global.css";
    .form-group {
        @apply flex flex-col gap-2;
    }
    .form-label {
        @apply text-sm font-semibold text-slate-700;
    }
    .form-input {
        @apply w-full px-4 py-3 rounded-xl bg-white border border-slate-300 text-slate-900 placeholder-slate-400
               focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent transition-all;
    }
    .form-hint {
        @apply text-xs text-slate-500;
    }
    .html-tag-btn {
        @apply px-2.5 py-1 text-[10px] font-bold rounded bg-slate-100 text-slate-600 border border-slate-200
               hover:bg-teal-600 hover:text-white hover:border-teal-500 transition-all;
    }
</style>

<script>
    const form = document.getElementById("edit-berita-form") as HTMLFormElement;
    const alertEl = document.getElementById("form-alert");
    const submitBtn = document.getElementById(
        "btn-submit",
    ) as HTMLButtonElement;
    const submitText = document.getElementById("btn-submit-text");
    const titleInput = document.getElementById("title") as HTMLInputElement;
    const titleCount = document.getElementById("title-count");
    const excerptEl = document.getElementById("excerpt") as HTMLTextAreaElement;
    const excerptCount = document.getElementById("excerpt-count");
    const newsId = form?.dataset.id;

    // ── Gallery Management ──────────────────────────────────────────────────
    const galleryContainer = document.getElementById("gallery-container");
    const btnAddGallery = document.getElementById("btn-add-gallery");
    const newImagesInput = document.getElementById(
        "new-images-input",
    ) as HTMLInputElement;

    // State to track images
    interface GalleryItem {
        id: string;
        url: string;
        file?: File;
        isExisting: boolean;
    }

    let galleryItems: GalleryItem[] = [];

    // Initialize with existing images
    document.querySelectorAll(".gallery-item").forEach((item) => {
        const url = (item as HTMLElement).dataset.url!;
        galleryItems.push({
            id: Math.random().toString(36),
            url,
            isExisting: true,
        });
    });

    function renderGallery() {
        if (!galleryContainer || !btnAddGallery) return;

        // Clear all except add button
        const items = galleryContainer.querySelectorAll(".gallery-item");
        items.forEach((el) => el.remove());

        galleryItems.forEach((item, index) => {
            const div = document.createElement("div");
            div.className =
                "gallery-item relative aspect-video group animate-in fade-in zoom-in duration-300";
            div.innerHTML = `
                <img src="${item.url}" class="w-full h-full object-cover rounded-xl border border-white/10" />
                <div class="absolute inset-0 bg-slate-950/40 opacity-0 group-hover:opacity-100 transition-opacity rounded-xl flex items-center justify-center gap-2">
                    <button type="button" class="btn-remove-item p-1.5 rounded-lg bg-red-500 text-white hover:bg-red-400 shadow-lg" title="Hapus Gambar">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                        </svg>
                    </button>
                </div>
                ${
                    index === 0
                        ? `
                    <div class="absolute top-2 left-2 px-2 py-0.5 rounded-md bg-indigo-600 text-[10px] font-bold text-white uppercase tracking-wider">
                        Cover
                    </div>
                `
                        : ""
                }
            `;

            div.querySelector(".btn-remove-item")?.addEventListener(
                "click",
                () => {
                    if (!item.isExisting && item.url)
                        URL.revokeObjectURL(item.url);
                    galleryItems = galleryItems.filter((i) => i.id !== item.id);
                    renderGallery();
                },
            );

            galleryContainer.insertBefore(div, btnAddGallery);
        });
    }

    btnAddGallery?.addEventListener("click", () => newImagesInput?.click());

    newImagesInput?.addEventListener("change", (e) => {
        const files = (e.target as HTMLInputElement).files;
        if (!files) return;

        const MAX_SIZE = 2 * 1024 * 1024; // 2MB
        for (const file of Array.from(files)) {
            if (file.size > MAX_SIZE) {
                showAlert(
                    `Ukuran gambar "${file.name}" terlalu besar. Maksimal 2MB.`,
                    "error",
                );
                continue;
            }
            const url = URL.createObjectURL(file);
            galleryItems.push({
                id: Math.random().toString(36),
                url,
                file,
                isExisting: false,
            });
        }
        renderGallery();
        newImagesInput.value = ""; // Reset
    });

    // Initial event delegation for existing buttons
    galleryContainer?.addEventListener("click", (e) => {
        const btn = (e.target as HTMLElement).closest(".btn-remove-gallery");
        if (btn) {
            const parent = btn.closest(".gallery-item") as HTMLElement;
            const url = parent.dataset.url;
            galleryItems = galleryItems.filter((i) => i.url !== url);
            renderGallery();
        }
    });

    // ── Slug auto-generate ──────────────────────────────────────────────────
    function toSlug(str: string): string {
        return str
            .toLowerCase()
            .normalize("NFD")
            .replace(/[\u0300-\u036f]/g, "")
            .replace(/[^a-z0-9\s-]/g, "")
            .replace(/\s+/g, " ") // hapus double spasi
            .trim()
            .replace(/\s+/g, "-")
            .replace(/-+/g, "-"); // hapus double dash
    }

    const slugPreview = document.getElementById("slug-preview");
    let currentSlug = slugPreview?.textContent ?? "";

    // ── Counters ──────────────────────────────────────────────────────────────
    titleInput?.addEventListener("input", () => {
        if (titleCount)
            titleCount.textContent = String(titleInput.value.length);
        // Update slug preview
        currentSlug = toSlug(titleInput.value);
        if (slugPreview) slugPreview.textContent = currentSlug;
    });
    excerptEl?.addEventListener("input", () => {
        if (excerptCount)
            excerptCount.textContent = String(excerptEl.value.length);
    });

    // ── Submit ────────────────────────────────────────────────────────────────
    form?.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (!alertEl || !newsId) return;
        alertEl.classList.add("hidden");

        const raw = new FormData(form);
        const title = (raw.get("title") as string).trim();

        if (!title) {
            showAlert("Judul wajib diisi.", "error");
            return;
        }

        if (galleryItems.length === 0) {
            showAlert("Minimal satu gambar wajib ada.", "error");
            return;
        }

        submitBtn.disabled = true;
        if (submitText) submitText.textContent = "Menyimpan...";

        const payload = new FormData();
        payload.append("title", title);
        payload.append("slug", currentSlug || toSlug(title));
        payload.append("excerpt", (raw.get("excerpt") as string).trim());
        payload.append("category", (raw.get("category") as string).trim());
        payload.append("author", (raw.get("author") as string).trim());
        payload.append("location", (raw.get("location") as string).trim());
        payload.append("content", (raw.get("content") as string).trim());

        const progId = raw.get("programId") as string;
        if (progId) {
            payload.append("programId", progId);
        } else {
            payload.append("programId", ""); // Send empty to clear relationship if needed
        }

        // Add existing images to keep
        galleryItems
            .filter((i) => i.isExisting)
            .forEach((i) => {
                payload.append("keep_images", i.url);
            });

        // Add new images to upload
        galleryItems
            .filter((i) => !i.isExisting)
            .forEach((i) => {
                if (i.file) payload.append("new_images", i.file);
            });

        try {
            const res = await fetch(`/api/berita/${newsId}`, {
                method: "PUT",
                body: payload,
            });
            const result = await res.json();

            if (result.success) {
                showAlert("✓ Berita berhasil diperbarui!", "success");
                setTimeout(() => {
                    window.location.href = "/berita";
                }, 1500);
            } else {
                showAlert(result.error ?? "Gagal memperbarui berita.", "error");
            }
        } catch {
            showAlert("Terjadi kesalahan jaringan.", "error");
        } finally {
            submitBtn.disabled = false;
            if (submitText) submitText.textContent = "Simpan Perubahan";
        }
    });

    function showAlert(msg: string, type: "success" | "error") {
        if (!alertEl) return;
        alertEl.textContent = msg;
        alertEl.className =
            type === "success"
                ? "mb-6 p-4 rounded-xl text-sm font-medium bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 block"
                : "mb-6 p-4 rounded-xl text-sm font-medium bg-red-500/10 border border-red-500/30 text-red-400 block";
    }

    // ── Content Tag Shortcuts ────────────────────────────────────────────────
    const contentTextarea = document.getElementById(
        "content",
    ) as HTMLTextAreaElement;
    const tagButtons = document.querySelectorAll(".html-tag-btn");

    tagButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
            const tag = (btn as HTMLElement).dataset.tag;
            if (!tag || !contentTextarea) return;

            const start = contentTextarea.selectionStart;
            const end = contentTextarea.selectionEnd;
            const text = contentTextarea.value;
            const selectedText = text.substring(start, end);

            let insertion = "";
            let newCursorPos = start;

            if (tag === "br") {
                insertion = "<br>\n";
                newCursorPos = start + insertion.length;
            } else if (tag === "a") {
                const url = prompt("Masukkan URL link:", "https://");
                if (url === null) return; // Cancelled
                insertion = `<a href="${url}" target="_blank" class="text-indigo-400 hover:underline"> ${selectedText || "link"} </a>`;
                newCursorPos = start + insertion.length;
            } else if (tag === "ul") {
                insertion = `<ul>\n  <li>${selectedText || "Item 1"}</li>\n  <li>Item 2</li>\n</ul>`;
                newCursorPos = start + insertion.length;
            } else if (tag === "p") {
                insertion = `<p>${selectedText}</p>\n`;
                newCursorPos = start + insertion.length;
            } else {
                insertion = `<${tag}>${selectedText}</${tag}>`;
                newCursorPos = start + tag.length + 2 + selectedText.length;
            }

            contentTextarea.value =
                text.substring(0, start) + insertion + text.substring(end);

            // Focus back and set cursor
            contentTextarea.focus();
            contentTextarea.setSelectionRange(newCursorPos, newCursorPos);

            // Trigger input event to clear error class if any
            contentTextarea.dispatchEvent(new Event("input"));
        });
    });
</script>
