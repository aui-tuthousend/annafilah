---
interface Props {
    slug: string;
    title: string;
    excerpt: string;
    category: string;
    date: string;
    author: string;
    readTime: string;
    image: string;
    isClone?: boolean;
}

const { slug, title, excerpt, category, date, author, readTime, image } =
    Astro.props;
---

<a
    href={`/artikel/${slug}`}
    class="artikel-slide group flex-shrink-0 w-full grid grid-cols-10 grid-rows-[200px_1fr] md:grid-rows-1 h-[450px] border border-slate-200 rounded-2xl overflow-hidden hover:border-teal-400/50 transition-all duration-300 shadow-sm"
>
    <!-- Kiri 3: Konten teks -->
    <div
        class="col-span-10 md:col-span-3 row-start-2 md:row-start-auto flex flex-col justify-between p-6 bg-white group-hover:bg-slate-50 transition-colors duration-300"
    >
        <div>
            <!-- Category + Read time -->
            <div class="flex items-center gap-3 mb-5">
                <span
                    class="px-3 py-1 rounded-full bg-teal-50 border border-teal-200 text-teal-700 text-xs font-semibold uppercase tracking-wider"
                >
                    {category}
                </span>
                <span class="text-slate-500 text-xs">⏱ {readTime}</span>
            </div>

            <!-- Title -->
            <h3
                class="text-slate-900 text-xl font-bold leading-tight mb-4 group-hover:text-teal-600 transition-colors duration-300"
            >
                {title}
            </h3>

            <!-- Excerpt — hanya intermezo, tidak penuh -->
            <p class="text-slate-500 text-sm leading-relaxed line-clamp-4">
                {excerpt}
            </p>
        </div>

        <!-- Footer: Author + Date + CTA -->
        <div class="mt-6 pt-4 border-t border-white/5">
            <p class="text-slate-400 text-xs mb-3">
                <span class="text-slate-700 font-medium">{author}</span>
                &nbsp;·&nbsp; {date}
            </p>
            <span
                class="inline-flex items-center gap-1.5 text-teal-600 text-sm font-semibold group-hover:gap-3 transition-all duration-300"
            >
                Baca Selengkapnya
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-4 h-4"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 5l7 7-7 7"></path>
                </svg>
            </span>
        </div>
    </div>

    <!-- Kanan 7: Gambar thumbnail -->
    <div
        class="col-span-10 md:col-span-7 row-start-1 md:row-start-auto relative overflow-hidden bg-slate-200"
    >
        <img
            src={image}
            alt={title}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
            loading="lazy"
        />
        <!-- Gradient overlay kiri agar menyatu dengan panel teks -->
        <div
            class="absolute inset-0 bg-gradient-to-r from-slate-900/60 via-transparent to-transparent pointer-events-none"
        >
        </div>
    </div>
</a>
