---
import Layout from "../../layouts/Layout.astro";
import { getArticleBySlug, getAllArticles } from "./-api/repository";

export const prerender = false;

// ─── Data ─────────────────────────────────────────────────────────────────────
const { slug } = Astro.params;
const artikel = await getArticleBySlug(slug as string);

if (!artikel) {
    return Astro.redirect("/artikel");
}

// Artikel terkait: kategori sama, bukan artikel ini sendiri (ambil dari DB)
const allArticles = await getAllArticles({ isPublished: true, limit: 100 });
const related = allArticles
    .filter((a) => a.category === artikel.category && a.slug !== artikel.slug)
    .slice(0, 3);

// Helper to format date
const formatDate = (date: Date) => {
    return new Intl.DateTimeFormat("id-ID", {
        day: "numeric",
        month: "long",
        year: "numeric",
    }).format(date);
};
---

<Layout
    title={`${artikel.title} – Yayasan Annafilah`}
    description={artikel.excerpt}
    ogImage={artikel.image}
>
    <!-- Hero Image -->
    <div
        class="relative w-full aspect-[2.5/1] md:aspect-[3/1] overflow-hidden bg-slate-900 mt-0"
    >
        <img
            src={artikel.image}
            alt={artikel.title}
            class="w-full h-full object-cover"
            loading="eager"
        />
        <div
            class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/60 to-transparent"
        >
        </div>

        <!-- Title Overlay -->
        <div class="absolute bottom-0 left-0 right-0 pb-10 px-6">
            <div class="max-w-4xl mx-auto">
                <span
                    class="inline-block px-3 py-1 rounded-full bg-indigo-600/90 text-white text-xs font-semibold uppercase tracking-widest mb-4"
                >
                    {artikel.category}
                </span>
                <h1
                    class="text-3xl md:text-5xl font-extrabold text-white leading-tight"
                >
                    {artikel.title}
                </h1>
            </div>
        </div>
    </div>

    <!-- Article Body -->
    <article class="py-16 px-6 bg-slate-950">
        <div class="max-w-4xl mx-auto">
            <!-- Meta info -->
            <div
                class="flex flex-wrap items-center gap-4 text-sm text-slate-400 mb-10 pb-8 border-b border-white/5"
            >
                <!-- Breadcrumb -->
                <nav
                    class="w-full flex items-center gap-2 text-xs text-slate-500 mb-2"
                >
                    <a href="/" class="hover:text-indigo-400 transition-colors"
                        >Beranda</a
                    >
                    <span>/</span>
                    <a
                        href="/artikel"
                        class="hover:text-indigo-400 transition-colors"
                        >Artikel</a
                    >
                    <span>/</span>
                    <span class="text-slate-300 truncate max-w-xs"
                        >{artikel.title}</span
                    >
                </nav>

                <!-- Author -->
                <span class="flex items-center gap-1.5">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-4 h-4"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                        ></path>
                    </svg>
                    {artikel.author}
                </span>

                <!-- Date -->
                <span class="flex items-center gap-1.5">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-4 h-4"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                        ></path>
                    </svg>
                    {formatDate(artikel.createdAt)}
                </span>

                <!-- Read time -->
                <span class="flex items-center gap-1.5">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-4 h-4"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                        ></path>
                    </svg>
                    {artikel.readingTime} baca
                </span>
            </div>

            <!-- Excerpt -->
            <p class="text-slate-300 text-xl leading-relaxed mb-8 font-light">
                {artikel.excerpt}
            </p>

            <!-- Main content -->
            <div
                class="prose prose-invert prose-lg max-w-none prose-p:text-slate-400 prose-p:leading-relaxed prose-headings:text-white prose-h2:text-2xl prose-h2:font-bold prose-h2:mt-10 prose-h2:mb-4"
                set:html={artikel.content}
            />

            <!-- Tags -->
            <div
                class="flex flex-wrap gap-2 mt-10 pt-8 border-t border-white/5"
            >
                {
                    artikel.tags.map((tag) => (
                        <span class="px-3 py-1 rounded-full bg-white/5 border border-white/10 text-slate-400 text-xs font-medium">
                            #{tag}
                        </span>
                    ))
                }
            </div>

            <!-- Back button -->
            <div class="mt-8">
                <a
                    href="/artikel"
                    class="inline-flex items-center gap-2 text-indigo-400 font-semibold hover:text-indigo-300 transition-colors"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-4 h-4"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M15 19l-7-7 7-7"></path>
                    </svg>
                    Kembali ke Artikel
                </a>
            </div>
        </div>
    </article>

    <!-- Related Articles -->
    {
        related.length > 0 && (
            <section class="py-16 px-6 bg-slate-900/50">
                <div class="max-w-4xl mx-auto">
                    <h2 class="text-2xl font-bold text-white mb-8">
                        Artikel Terkait
                    </h2>
                    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-5">
                        {related.map((item) => (
                            <a
                                href={`/artikel/${item.slug}`}
                                class="group block bg-slate-900 border border-white/5 rounded-xl overflow-hidden hover:border-indigo-500/30 hover:-translate-y-1 transition-all duration-300"
                            >
                                <div class="relative aspect-[16/9] overflow-hidden bg-slate-800">
                                    <img
                                        src={item.image}
                                        alt={item.title}
                                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                        loading="lazy"
                                    />
                                </div>
                                <div class="p-4">
                                    <span class="text-indigo-400 text-xs font-semibold uppercase tracking-wider">
                                        {item.category}
                                    </span>
                                    <h3 class="text-white font-semibold text-sm leading-snug line-clamp-2 mt-1 group-hover:text-indigo-300 transition-colors">
                                        {item.title}
                                    </h3>
                                    <p class="text-slate-500 text-xs mt-2">
                                        {item.author} · {item.readingTime}
                                    </p>
                                </div>
                            </a>
                        ))}
                    </div>
                </div>
            </section>
        )
    }
</Layout>
