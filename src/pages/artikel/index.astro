---
import Layout from "../../layouts/Layout.astro";
import { getAllArticles } from "./-api/repository";

export const prerender = false;

const articles = await getAllArticles({ isPublished: true, limit: 100 });
const categories = ["Semua", ...new Set(articles.map((a) => a.category))];

// AUTH: Ambil status login dari context.locals (optimal: tanpa query DB tambahan)
const isLoggedIn = !!Astro.locals.username;

// Helper to format date
const formatDate = (date: Date) => {
    return new Intl.DateTimeFormat("id-ID", {
        day: "numeric",
        month: "long",
        year: "numeric",
    }).format(date);
};
---

<Layout
    title="Artikel & Wawasan – Yayasan Annafilah"
    description="Kumpulan artikel, panduan, wawasan, dan insight dari Yayasan Annafilah untuk menambah wawasan cakrawala Anda."
>
    <!-- Page Header -->
    <section class="pt-36 pb-12 bg-slate-50 px-6">
        <div class="max-w-7xl mx-auto">
            <!-- Breadcrumb -->
            <nav class="text-sm text-slate-500 mb-6 flex items-center gap-2">
                <a href="/" class="hover:text-teal-600 transition-colors">Beranda</a>
                <span>/</span>
                <span class="text-slate-300">Artikel</span>
            </nav>

            <p class="text-teal-600 font-semibold text-sm uppercase tracking-widest mb-3">
                Wawasan & Inspirasi
            </p>
            <div class="flex items-center justify-between gap-4 mb-4 flex-wrap">
                <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900">
                    Artikel & Inspirasi
                </h1>
                {isLoggedIn && (
                    <a
                        href="/artikel/create"
                        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-teal-600 hover:bg-teal-500 text-white font-semibold text-sm transition-all duration-200 hover:shadow-lg hover:shadow-teal-500/25 shrink-0"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="w-4 h-4"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M12 4v16m8-8H4"
                            ></path>
                        </svg>
                        Tambah Artikel
                    </a>
                )}
            </div>
            <p class="text-slate-600 text-lg max-w-2xl">
                Kumpulan tulisan mendalam dari tim Annafilah untuk membantu
                masyarakat tumbuh lebih cerdas.
            </p>
        </div>
    </section>

    <div class="border-t border-slate-200 bg-slate-50"></div>

    <!-- Filter + Grid -->
    <section class="py-16 px-6 bg-slate-50 min-h-screen">
        <div class="max-w-7xl mx-auto">
            <!-- Category Filter -->
            <div class="flex flex-wrap gap-2 mb-10" id="filter-bar">
                {categories.map((cat, i) => (
                    <button
                        class={`filter-btn px-4 py-1.5 rounded-full text-sm font-medium border transition-all duration-200 ${
                            i === 0
                                ? "bg-teal-600 border-teal-600 text-white"
                                : "bg-transparent border-slate-200 text-slate-500 hover:border-teal-400/50 hover:text-slate-900"
                        }`}
                        data-filter={cat}
                    >
                        {cat}
                    </button>
                ))}
            </div>

            <!-- Artikel Grid -->
            <div id="artikel-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {articles.map((item) => (
                    <div class="artikel-item" data-category={item.category}>
                        <a
                            href={`/artikel/${item.slug}`}
                            class="group flex flex-col h-full border border-slate-200 rounded-2xl overflow-hidden bg-white hover:border-teal-400/50 hover:-translate-y-1 transition-all duration-300 shadow-sm"
                        >
                            <!-- Thumbnail -->
                            <div class="relative aspect-[16/9] overflow-hidden bg-slate-200">
                                <img
                                    src={item.image}
                                    alt={item.title}
                                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                    loading="lazy"
                                />
                                <div class="absolute top-3 left-3 right-3 flex justify-between items-center z-10">
                                    <span class="px-2.5 py-1 rounded-full bg-slate-950/80 text-teal-600 text-xs font-semibold uppercase tracking-wider backdrop-blur-sm">
                                        {item.category}
                                    </span>
                                    {isLoggedIn && (
                                        <div class="flex gap-2">
                                            <button
                                                onclick={`event.preventDefault(); event.stopPropagation(); window.location.href='/artikel/edit/${item.slug}'`}
                                                class="p-1.5 rounded-full bg-white/80 text-slate-700 hover:text-teal-600 border border-slate-200 hover:border-teal-400/50 backdrop-blur-sm transition-all group/edit"
                                                title="Edit Artikel"
                                            >
                                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                                                </svg>
                                            </button>
                                            <button
                                                onclick={`event.preventDefault(); event.stopPropagation(); if(confirm('Hapus artikel ini?')){ fetch('/api/artikel/${item.id}', {method:'DELETE'}).then(r => r.json()).then(res => { if(res.success) window.location.reload(); else alert(res.error); }) }`}
                                                class="p-1.5 rounded-full bg-red-500/20 text-red-400 hover:bg-red-500 hover:text-white border border-red-500/30 backdrop-blur-sm transition-all"
                                                title="Hapus Artikel"
                                            >
                                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                </svg>
                                            </button>
                                        </div>
                                    )}
                                </div>
                            </div>

                            <!-- Content -->
                            <div class="flex flex-col flex-1 p-6">
                                <h2 class="text-slate-900 font-bold text-lg leading-snug line-clamp-2 mb-3 group-hover:text-teal-600 transition-colors">
                                    {item.title}
                                </h2>
                                <p class="text-slate-500 text-sm leading-relaxed line-clamp-3 flex-1">
                                    {item.excerpt}
                                </p>
                                <div class="flex items-center justify-between mt-5 pt-5 border-t border-white/5">
                                    <div class="text-xs text-slate-400">
                                        <span class="text-slate-700 font-medium">{item.author}</span>
                                        &nbsp;·&nbsp; {item.readingTime}
                                    </div>
                                    <span class="text-xs text-slate-500">{formatDate(item.createdAt)}</span>
                                </div>
                            </div>
                        </a>
                    </div>
                ))}
            </div>

            <!-- Empty State -->
            <div id="empty-state" class={`text-center py-24 text-slate-500 ${articles.length > 0 ? "hidden" : ""}`}>
                <p class="text-4xl mb-4">📭</p>
                <p class="text-lg font-medium text-slate-400">
                    {articles.length === 0 ? "Belum ada artikel yang diterbitkan." : "Tidak ada artikel di kategori ini."}
                </p>
            </div>
        </div>
    </section>
</Layout>

<script>
    function setupFilter() {
        const buttons = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
        const items = document.querySelectorAll<HTMLElement>(".artikel-item");
        const emptyState = document.getElementById("empty-state");

        buttons.forEach((btn) => {
            btn.addEventListener("click", () => {
                const filter = btn.dataset.filter ?? "Semua";

                buttons.forEach((b) => {
                    b.classList.remove("bg-teal-600", "border-teal-600", "text-white");
                    b.classList.add("bg-transparent", "border-slate-200", "text-slate-500");
                });
                btn.classList.add("bg-teal-600", "border-teal-600", "text-white");
                btn.classList.remove("bg-transparent", "border-slate-200", "text-slate-500");

                let visible = 0;
                items.forEach((item) => {
                    const match = filter === "Semua" || item.dataset.category === filter;
                    item.style.display = match ? "" : "none";
                    if (match) visible++;
                });

                if (emptyState) {
                    emptyState.classList.toggle("hidden", visible > 0);
                }
            });
        });
    }

    setupFilter();
    document.addEventListener("astro:after-swap", setupFilter);
</script>
