---
import Layout from "../../../layouts/Layout.astro";
import { getArticleBySlugAdmin } from "../-api/repository";

export const prerender = false;

const { slug } = Astro.params;

if (!slug) {
    return Astro.redirect("/artikel");
}

const article = await getArticleBySlugAdmin(slug);

if (!article) {
    return Astro.redirect("/404");
}

// Map categories to selections
const categories = [
    "Bisnis",
    "Teknologi",
    "Pertanian",
    "Peternakan",
    "Keuangan",
    "Manajemen",
    "Inspirasi",
    "Tips & Trik",
    "Lainnya",
];
---

<Layout
    title={`Edit Artikel: ${article.title} – Annafilah`}
    description={`Form untuk mengedit artikel "${article.title}" di Yayasan Annafilah.`}
>
    <div class="min-h-screen bg-slate-950 pt-28 pb-20 px-6">
        <div class="max-w-3xl mx-auto">
            <!-- Header -->
            <div class="mb-10">
                <nav
                    class="text-sm text-slate-500 mb-6 flex items-center gap-2"
                >
                    <a href="/" class="hover:text-indigo-400 transition-colors"
                        >Beranda</a
                    >
                    <span>/</span>
                    <a
                        href="/artikel"
                        class="hover:text-indigo-400 transition-colors"
                        >Artikel</a
                    >
                    <span>/</span>
                    <span class="text-slate-300">Edit Artikel</span>
                </nav>
                <p
                    class="text-indigo-400 font-semibold text-sm uppercase tracking-widest mb-2"
                >
                    Manajemen Konten
                </p>
                <h1 class="text-4xl font-extrabold text-white">Edit Artikel</h1>
                <p class="text-slate-400 mt-2">
                    Perbarui informasi artikel di bawah ini.
                </p>
            </div>

            <!-- Alert area -->
            <div
                id="form-alert"
                class="hidden mb-6 p-4 rounded-xl text-sm font-medium"
            >
            </div>

            <!-- Form -->
            <form
                id="edit-artikel-form"
                novalidate
                class="space-y-6"
                data-id={article.id}
                data-current-slug={article.slug}
            >
                <!-- Title -->
                <div class="form-group">
                    <label for="title" class="form-label">
                        Judul Artikel <span class="text-red-400">*</span>
                    </label>
                    <input
                        type="text"
                        id="title"
                        name="title"
                        required
                        maxlength="100"
                        value={article.title}
                        placeholder="Tulis judul artikel yang menarik..."
                        class="form-input"
                    />
                    <p class="form-hint text-right">
                        <span id="title-count">{article.title.length}</span>/100
                    </p>
                </div>

                <!-- Excerpt -->
                <div class="form-group">
                    <label for="excerpt" class="form-label">
                        Ringkasan <span class="text-red-400">*</span>
                        <span class="text-slate-500 font-normal text-xs ml-2"
                            >(ditampilkan di listing)</span
                        >
                    </label>
                    <textarea
                        id="excerpt"
                        name="excerpt"
                        required
                        maxlength="300"
                        rows="3"
                        placeholder="Tuliskan ringkasan singkat artikel ini..."
                        class="form-input resize-none"
                        >{article.excerpt}</textarea
                    >
                    <p class="form-hint text-right">
                        <span id="excerpt-count">{article.excerpt.length}</span
                        >/300
                    </p>
                </div>

                <!-- Category + Author -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    <div class="form-group">
                        <label for="category" class="form-label">
                            Kategori <span class="text-red-400">*</span>
                        </label>
                        <select
                            id="category"
                            name="category"
                            required
                            class="form-input"
                        >
                            <option value="" disabled>Pilih kategori...</option>
                            {
                                categories.map((cat) => (
                                    <option
                                        value={cat}
                                        selected={article.category === cat}
                                    >
                                        {cat}
                                    </option>
                                ))
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="author" class="form-label">
                            Penulis <span class="text-red-400">*</span>
                        </label>
                        <input
                            type="text"
                            id="author"
                            name="author"
                            required
                            value={article.author}
                            placeholder="Nama penulis..."
                            class="form-input"
                        />
                    </div>
                </div>

                <!-- Reading Time + Tags -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    <div class="form-group">
                        <label for="readingTime" class="form-label">
                            Estimasi Waktu Baca <span class="text-red-400"
                                >*</span
                            >
                        </label>
                        <input
                            type="text"
                            id="readingTime"
                            name="readingTime"
                            required
                            value={article.readingTime}
                            placeholder="Contoh: 5 menit baca"
                            class="form-input"
                        />
                    </div>
                    <div class="form-group">
                        <label for="tags-input" class="form-label">
                            Tags
                            <span
                                class="text-slate-500 font-normal text-xs ml-2"
                                >(opsional, tekan Enter)</span
                            >
                        </label>
                        <div class="relative">
                            <input
                                type="text"
                                id="tags-input"
                                placeholder="Tulis tag lalu Enter..."
                                class="form-input pr-10"
                                autocomplete="off"
                            />
                            <input
                                type="hidden"
                                id="tags-hidden"
                                name="tags"
                                value={JSON.stringify(article.tags)}
                            />
                        </div>
                        <div
                            id="tags-pills"
                            class="flex flex-wrap gap-1.5 mt-2 empty:hidden"
                        >
                        </div>
                    </div>
                </div>

                <!-- Thumbnail Image -->
                <div class="form-group">
                    <label class="form-label">
                        Gambar Thumbnail
                        <span class="text-slate-500 font-normal text-xs ml-2"
                            >(kosongkan jika tidak ingin mengganti)</span
                        >
                    </label>

                    <div
                        id="upload-zone"
                        class="relative cursor-pointer group/zone"
                    >
                        <input
                            type="file"
                            id="image"
                            name="image"
                            accept="image/*"
                            class="sr-only"
                        />

                        <!-- Initial state (Current Image) -->
                        <div id="img-preview" class="relative">
                            <img
                                id="img-preview-src"
                                src={article.image}
                                alt="Current thumbnail"
                                class="w-full max-h-64 object-cover rounded-2xl border border-white/10 group-hover/zone:border-indigo-500/50 transition-colors"
                            />
                            <div
                                class="absolute inset-0 flex flex-col items-center justify-center bg-slate-950/40 opacity-0 group-hover/zone:opacity-100 transition-opacity rounded-2xl"
                            >
                                <p class="text-white font-bold">Ganti Gambar</p>
                                <p
                                    class="text-slate-300 text-xs mt-1 text-center px-4"
                                >
                                    Klik atau drag gambar baru ke sini
                                </p>
                            </div>
                            <div class="absolute bottom-3 left-3">
                                <span
                                    class="px-2 py-1 rounded-full bg-indigo-600/90 text-white text-xs font-semibold backdrop-blur-sm"
                                >
                                    Thumbnail Saat Ini
                                </span>
                            </div>
                            <button
                                type="button"
                                id="btn-remove-img"
                                class="hidden absolute top-3 right-3 w-8 h-8 flex items-center justify-center rounded-full bg-red-500 hover:bg-red-400 text-white text-sm font-bold shadow-lg transition-opacity"
                                title="Batalkan penggantian"
                            >
                                ✕
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Content -->
                <div class="form-group">
                    <label for="content" class="form-label">
                        Konten Artikel <span class="text-red-400">*</span>
                        <span class="text-slate-500 font-normal text-xs ml-2"
                            >(mendukung HTML)</span
                        >
                    </label>

                    <div
                        class="flex flex-wrap items-center gap-1.5 p-2 rounded-xl bg-slate-900/50 border border-white/5 mb-1"
                    >
                        <button
                            type="button"
                            class="html-tag-btn"
                            data-tag="p"
                            title="Paragraph">P</button
                        >
                        <button
                            type="button"
                            class="html-tag-btn"
                            data-tag="br"
                            title="Line Break">BR</button
                        >
                        <div class="w-px h-4 bg-white/10 mx-1"></div>
                        <button
                            type="button"
                            class="html-tag-btn font-bold"
                            data-tag="strong"
                            title="Bold">B</button
                        >
                        <button
                            type="button"
                            class="html-tag-btn italic"
                            data-tag="em"
                            title="Italic">I</button
                        >
                        <button
                            type="button"
                            class="html-tag-btn underline"
                            data-tag="u"
                            title="Underline">U</button
                        >
                        <div class="w-px h-4 bg-white/10 mx-1"></div>
                        <button
                            type="button"
                            class="html-tag-btn"
                            data-tag="h2"
                            title="Heading 2">H2</button
                        >
                        <button
                            type="button"
                            class="html-tag-btn"
                            data-tag="h3"
                            title="Heading 3">H3</button
                        >
                        <div class="w-px h-4 bg-white/10 mx-1"></div>
                        <button
                            type="button"
                            class="html-tag-btn"
                            data-tag="ul"
                            title="Unordered List">UL</button
                        >
                        <button
                            type="button"
                            class="html-tag-btn"
                            data-tag="li"
                            title="List Item">LI</button
                        >
                        <div class="w-px h-4 bg-white/10 mx-1"></div>
                        <button
                            type="button"
                            class="html-tag-btn text-lg leading-none"
                            data-tag="blockquote"
                            title="Quote">"</button
                        >
                        <button
                            type="button"
                            class="html-tag-btn"
                            data-tag="a"
                            title="Link">Link</button
                        >
                        <button
                            type="button"
                            class="html-tag-btn"
                            data-tag="hr"
                            title="Horizontal Line">HR</button
                        >
                    </div>

                    <textarea
                        id="content"
                        name="content"
                        required
                        rows="16"
                        placeholder="Tulis konten artikel di sini..."
                        class="form-input resize-y font-mono text-sm"
                        >{article.content}</textarea
                    >
                </div>

                <!-- Action Buttons -->
                <div class="flex gap-4 pt-2">
                    <button
                        type="submit"
                        id="btn-submit"
                        class="flex-1 flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-base transition-all duration-200 hover:shadow-lg hover:shadow-indigo-500/25 disabled:opacity-50"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="w-5 h-5"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M5 13l4 4L19 7"></path>
                        </svg>
                        <span id="btn-submit-text">Simpan Perubahan</span>
                    </button>
                    <a
                        href="/artikel"
                        class="px-6 py-3.5 rounded-xl border border-white/10 bg-slate-900 hover:bg-slate-800 text-slate-300 font-semibold text-base transition-colors"
                    >
                        Batal
                    </a>
                </div>
            </form>
        </div>
    </div>
</Layout>

<style>
    @reference "../../../styles/global.css";
    .form-group {
        @apply flex flex-col gap-2;
    }
    .form-label {
        @apply text-sm font-semibold text-slate-200;
    }
    .form-input {
        @apply w-full px-4 py-3 rounded-xl bg-slate-900 border border-white/10 text-white placeholder-slate-500
               focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all;
    }
    .form-hint {
        @apply text-xs text-slate-500;
    }
    .html-tag-btn {
        @apply px-2.5 py-1 text-[10px] font-bold rounded bg-slate-800 text-slate-400 border border-white/5
               hover:bg-indigo-600 hover:text-white hover:border-indigo-500 transition-all;
    }
    .tag-pill {
        @apply inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-indigo-600/20 border border-indigo-500/30
               text-indigo-300 text-xs font-medium;
    }
</style>

<script>
    const form = document.getElementById(
        "edit-artikel-form",
    ) as HTMLFormElement;
    const alertEl = document.getElementById("form-alert");
    const submitBtn = document.getElementById(
        "btn-submit",
    ) as HTMLButtonElement;
    const submitText = document.getElementById("btn-submit-text");
    const titleInput = document.getElementById("title") as HTMLInputElement;
    const titleCount = document.getElementById("title-count");
    const excerptEl = document.getElementById("excerpt") as HTMLTextAreaElement;
    const excerptCount = document.getElementById("excerpt-count");

    const imgInput = document.getElementById("image") as HTMLInputElement;
    const imgPreviewSrc = document.getElementById(
        "img-preview-src",
    ) as HTMLImageElement;
    const btnRemoveImg = document.getElementById("btn-remove-img");
    const initialImgSrc = imgPreviewSrc?.src;

    const tagsHidden = document.getElementById(
        "tags-hidden",
    ) as HTMLInputElement;
    const tagsInputEl = document.getElementById(
        "tags-input",
    ) as HTMLInputElement;
    const tagsPills = document.getElementById("tags-pills");

    const articleId = form?.dataset.id;
    const initialSlug = form?.dataset.currentSlug;

    let selectedFile: File | null = null;
    let previewUrl: string | null = null;
    let tags: string[] = JSON.parse(tagsHidden?.value || "[]");

    // ── Character Counters ────────────────────────────────────────────────────
    titleInput?.addEventListener("input", () => {
        if (titleCount)
            titleCount.textContent = String(titleInput.value.length);
    });
    excerptEl?.addEventListener("input", () => {
        if (excerptCount)
            excerptCount.textContent = String(excerptEl.value.length);
    });

    // ── Image Handling ────────────────────────────────────────────────────────
    imgInput?.addEventListener("change", (e) => {
        const files = (e.target as HTMLInputElement).files;
        if (files && files[0]) {
            selectedFile = files[0];
            if (previewUrl) URL.revokeObjectURL(previewUrl);
            previewUrl = URL.createObjectURL(selectedFile);
            if (imgPreviewSrc) imgPreviewSrc.src = previewUrl;
            btnRemoveImg?.classList.remove("hidden");
        }
    });

    btnRemoveImg?.addEventListener("click", (e) => {
        e.stopPropagation();
        selectedFile = null;
        if (previewUrl) URL.revokeObjectURL(previewUrl);
        previewUrl = null;
        if (imgPreviewSrc) imgPreviewSrc.src = initialImgSrc;
        if (imgInput) imgInput.value = "";
        btnRemoveImg?.classList.add("hidden");
    });

    // ── Tags Handling ─────────────────────────────────────────────────────────
    function renderTags() {
        if (!tagsPills || !tagsHidden) return;
        tagsPills.innerHTML = "";
        tags.forEach((tag, idx) => {
            const pill = document.createElement("span");
            pill.className = "tag-pill";
            pill.innerHTML = `${tag}<button type="button" class="ml-1 opacity-60 hover:opacity-100 font-bold" data-idx="${idx}">×</button>`;
            pill.querySelector("button")?.addEventListener("click", () => {
                tags.splice(idx, 1);
                renderTags();
            });
            tagsPills.appendChild(pill);
        });
        tagsHidden.value = JSON.stringify(tags);
    }
    renderTags();

    tagsInputEl?.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === ",") {
            e.preventDefault();
            const val = tagsInputEl.value.trim().replace(/,/g, "");
            if (val && !tags.includes(val) && tags.length < 10) {
                tags.push(val);
                renderTags();
            }
            tagsInputEl.value = "";
        }
    });

    // ── Submit ────────────────────────────────────────────────────────────────
    form?.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (!alertEl || !articleId) return;
        alertEl.classList.add("hidden");

        const raw = new FormData(form);
        const title = (raw.get("title") as string).trim();

        if (!title) {
            showAlert("Judul wajib diisi.", "error");
            return;
        }

        submitBtn.disabled = true;
        if (submitText) submitText.textContent = "Menyimpan...";

        const payload = new FormData();
        payload.append("title", title);
        payload.append("excerpt", (raw.get("excerpt") as string).trim());
        payload.append("category", (raw.get("category") as string).trim());
        payload.append("author", (raw.get("author") as string).trim());
        payload.append(
            "readingTime",
            (raw.get("readingTime") as string).trim(),
        );
        payload.append("content", (raw.get("content") as string).trim());
        payload.append("tags", JSON.stringify(tags));

        if (selectedFile) {
            payload.append("image", selectedFile);
        }

        try {
            const res = await fetch(`/api/artikel/${articleId}`, {
                method: "PUT",
                body: payload,
            });
            const result = await res.json();

            if (result.success) {
                showAlert("✓ Artikel berhasil diperbarui!", "success");
                setTimeout(() => {
                    window.location.href = "/artikel";
                }, 1500);
            } else {
                showAlert(
                    result.error ?? "Gagal memperbarui artikel.",
                    "error",
                );
            }
        } catch {
            showAlert("Terjadi kesalahan jaringan.", "error");
        } finally {
            submitBtn.disabled = false;
            if (submitText) submitText.textContent = "Simpan Perubahan";
        }
    });

    function showAlert(msg: string, type: "success" | "error") {
        if (!alertEl) return;
        alertEl.textContent = msg;
        alertEl.className =
            type === "success"
                ? "mb-6 p-4 rounded-xl text-sm font-medium bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 block"
                : "mb-6 p-4 rounded-xl text-sm font-medium bg-red-500/10 border border-red-500/30 text-red-400 block";
    }

    // ── Content Shortcuts ──
    const contentTextarea = document.getElementById(
        "content",
    ) as HTMLTextAreaElement;
    document.querySelectorAll(".html-tag-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
            const tag = (btn as HTMLElement).dataset.tag;
            if (!tag || !contentTextarea) return;
            const start = contentTextarea.selectionStart;
            const end = contentTextarea.selectionEnd;
            const text = contentTextarea.value;
            const selectedText = text.substring(start, end);
            let insertion = `<${tag}>${selectedText}</${tag}>`;
            if (tag === "br") insertion = "<br>\n";
            if (tag === "hr") insertion = "<hr>\n";
            contentTextarea.value =
                text.substring(0, start) + insertion + text.substring(end);
            contentTextarea.focus();
        });
    });
</script>
