---
import Layout from "../../layouts/Layout.astro";

// Middleware sudah memvalidasi login sebelum halaman ini dirender.
const authorName = Astro.locals.username ?? "";
const categories = [
    "Bisnis",
    "Teknologi",
    "Pertanian",
    "Peternakan",
    "Keuangan",
    "Manajemen",
    "Inspirasi",
    "Tips & Trik",
    "Lainnya",
];
---

<Layout
    title="Tambah Artikel – Annafilah"
    description="Form untuk membuat artikel baru di Yayasan Annafilah."
>
    <div class="min-h-screen bg-slate-50 pt-28 pb-20 px-6">
        <div class="max-w-3xl mx-auto">
            <!-- Header -->
            <div class="mb-10">
                <nav
                    class="text-sm text-slate-500 mb-6 flex items-center gap-2"
                >
                    <a href="/" class="hover:text-teal-600 transition-colors"
                        >Beranda</a
                    >
                    <span>/</span>
                    <a
                        href="/artikel"
                        class="hover:text-teal-600 transition-colors">Artikel</a
                    >
                    <span>/</span>
                    <span class="text-slate-300">Tambah Artikel</span>
                </nav>
                <p
                    class="text-teal-600 font-semibold text-sm uppercase tracking-widest mb-2"
                >
                    Manajemen Konten
                </p>
                <h1 class="text-4xl font-extrabold text-slate-900">
                    Tambah Artikel Baru
                </h1>
                <p class="text-slate-500 mt-2">
                    Isi semua field yang diperlukan untuk mempublikasikan
                    artikel.
                </p>
            </div>

            <!-- Alert area -->
            <div
                id="form-alert"
                class="hidden mb-6 p-4 rounded-xl text-sm font-medium"
            >
            </div>

            <!-- Form -->
            <form id="create-artikel-form" novalidate class="space-y-6">
                <!-- Title -->
                <div class="form-group">
                    <label for="title" class="form-label">
                        Judul Artikel <span class="text-red-400">*</span>
                    </label>
                    <input
                        type="text"
                        id="title"
                        name="title"
                        required
                        maxlength="100"
                        placeholder="Tulis judul artikel yang menarik..."
                        class="form-input"
                    />
                    <p class="form-hint text-right">
                        <span id="title-count">0</span>/100
                    </p>
                </div>

                <!-- Excerpt -->
                <div class="form-group">
                    <label for="excerpt" class="form-label">
                        Ringkasan <span class="text-red-400">*</span>
                        <span class="text-slate-500 font-normal text-xs ml-2"
                            >(ditampilkan di listing)</span
                        >
                    </label>
                    <textarea
                        id="excerpt"
                        name="excerpt"
                        required
                        maxlength="300"
                        rows="3"
                        placeholder="Tuliskan ringkasan singkat artikel ini..."
                        class="form-input resize-none"></textarea>
                    <p class="form-hint text-right">
                        <span id="excerpt-count">0</span>/300
                    </p>
                </div>

                <!-- Category + Author -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    <div class="form-group">
                        <label for="category" class="form-label">
                            Kategori <span class="text-red-400">*</span>
                        </label>
                        <select
                            id="category"
                            name="category"
                            required
                            class="form-input"
                        >
                            <option value="" disabled>Pilih kategori...</option>
                            {
                                categories.map((cat) => (
                                    <option value={cat}>{cat}</option>
                                ))
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="author" class="form-label">
                            Penulis <span class="text-red-400">*</span>
                        </label>
                        <input
                            type="text"
                            id="author"
                            name="author"
                            required
                            value={authorName}
                            placeholder="Nama penulis..."
                            class="form-input"
                        />
                    </div>
                </div>

                <!-- Reading Time + Tags -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    <div class="form-group">
                        <label for="readingTime" class="form-label">
                            Estimasi Waktu Baca <span class="text-red-400"
                                >*</span
                            >
                        </label>
                        <input
                            type="text"
                            id="readingTime"
                            name="readingTime"
                            required
                            placeholder="Contoh: 5 menit baca"
                            class="form-input"
                        />
                    </div>
                    <div class="form-group">
                        <label for="tags-input" class="form-label">
                            Tags
                            <span
                                class="text-slate-500 font-normal text-xs ml-2"
                                >(opsional, tekan Enter)</span
                            >
                        </label>
                        <div class="relative">
                            <input
                                type="text"
                                id="tags-input"
                                placeholder="Tulis tag lalu Enter..."
                                class="form-input pr-10"
                                autocomplete="off"
                            />
                            <input
                                type="hidden"
                                id="tags-hidden"
                                name="tags"
                                value="[]"
                            />
                        </div>
                        <!-- Tags Pills -->
                        <div
                            id="tags-pills"
                            class="flex flex-wrap gap-1.5 mt-2 empty:hidden"
                        >
                        </div>
                    </div>
                </div>

                <!-- Thumbnail Image -->
                <div class="form-group">
                    <label class="form-label">
                        Gambar Thumbnail <span class="text-red-400">*</span>
                        <span class="text-slate-500 font-normal text-xs ml-2"
                            >(ditampilkan di listing artikel)</span
                        >
                    </label>

                    <!-- Upload Drop Zone -->
                    <div id="upload-zone" class="relative cursor-pointer">
                        <input
                            type="file"
                            id="image"
                            name="image"
                            accept="image/*"
                            class="sr-only"
                        />
                        <div
                            id="drop-ui"
                            class="flex flex-col items-center justify-center border-2 border-dashed border-slate-300 rounded-2xl p-10 bg-slate-100 hover:border-teal-500/50 hover:bg-teal-50/30 transition-all duration-300"
                        >
                            <div
                                class="w-16 h-16 rounded-full bg-teal-50 border border-teal-200 flex items-center justify-center mb-4"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="w-8 h-8 text-teal-500"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                                    ></path>
                                </svg>
                            </div>
                            <p class="text-slate-900 font-semibold">
                                Klik atau drag & drop gambar
                            </p>
                            <p class="text-slate-500 text-sm mt-1">
                                PNG, JPG atau WebP &mdash; 1 gambar thumbnail
                            </p>
                        </div>

                        <!-- Preview after upload -->
                        <div
                            id="img-preview"
                            class="hidden mt-4 relative group"
                        >
                            <img
                                id="img-preview-src"
                                src=""
                                alt="Preview thumbnail"
                                class="w-full max-h-64 object-cover rounded-2xl border border-white/10"
                            />
                            <button
                                type="button"
                                id="btn-remove-img"
                                class="absolute top-3 right-3 w-8 h-8 flex items-center justify-center rounded-full bg-red-500 hover:bg-red-400 text-white text-sm font-bold shadow-lg opacity-0 group-hover:opacity-100 transition-opacity"
                                title="Hapus gambar"
                            >
                                ✕
                            </button>
                            <div class="absolute bottom-3 left-3">
                                <span
                                    class="px-2 py-1 rounded-full bg-teal-600/90 text-white text-xs font-semibold backdrop-blur-sm"
                                >
                                    Thumbnail
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Content -->
                <div class="form-group">
                    <label for="content" class="form-label">
                        Konten Artikel <span class="text-red-400">*</span>
                        <span class="text-slate-500 font-normal text-xs ml-2"
                            >(mendukung HTML)</span
                        >
                    </label>

                    <!-- HTML Shortcut Buttons -->
                    <div
                        class="flex flex-wrap items-center gap-1.5 p-2 rounded-xl bg-slate-100 border border-slate-200 mb-1"
                    >
                        <button
                            type="button"
                            class="html-tag-btn"
                            data-tag="p"
                            title="Paragraph (Alinea Baru)">P</button
                        >
                        <button
                            type="button"
                            class="html-tag-btn"
                            data-tag="br"
                            title="Line Break (Garis Baru)">BR</button
                        >
                        <div class="w-px h-4 bg-slate-300 mx-1"></div>
                        <button
                            type="button"
                            class="html-tag-btn font-bold"
                            data-tag="strong"
                            title="Bold (Tebal)">B</button
                        >
                        <button
                            type="button"
                            class="html-tag-btn italic"
                            data-tag="em"
                            title="Italic (Miring)">I</button
                        >
                        <button
                            type="button"
                            class="html-tag-btn underline"
                            data-tag="u"
                            title="Underline (Garis Bawah)">U</button
                        >
                        <div class="w-px h-4 bg-slate-300 mx-1"></div>
                        <button
                            type="button"
                            class="html-tag-btn"
                            data-tag="h2"
                            title="Heading 2 (Judul Bagian)">H2</button
                        >
                        <button
                            type="button"
                            class="html-tag-btn"
                            data-tag="h3"
                            title="Heading 3 (Sub-judul)">H3</button
                        >
                        <div class="w-px h-4 bg-slate-300 mx-1"></div>
                        <button
                            type="button"
                            class="html-tag-btn"
                            data-tag="ul"
                            title="Unordered List (Daftar)">UL</button
                        >
                        <button
                            type="button"
                            class="html-tag-btn"
                            data-tag="li"
                            title="List Item (Poin Daftar)">LI</button
                        >
                        <button
                            type="button"
                            class="html-tag-btn"
                            data-tag="ol"
                            title="Ordered List (Daftar Bernomor)">OL</button
                        >
                        <div class="w-px h-4 bg-slate-300 mx-1"></div>
                        <button
                            type="button"
                            class="html-tag-btn text-lg leading-none"
                            data-tag="blockquote"
                            title="Quote (Kutipan)">"</button
                        >
                        <button
                            type="button"
                            class="html-tag-btn"
                            data-tag="a"
                            title="Link (Tautan)">Link</button
                        >
                        <button
                            type="button"
                            class="html-tag-btn"
                            data-tag="code"
                            title="Inline Code">Code</button
                        >
                        <button
                            type="button"
                            class="html-tag-btn"
                            data-tag="hr"
                            title="Horizontal Rule (Garis Pemisah)">HR</button
                        >
                    </div>

                    <textarea
                        id="content"
                        name="content"
                        required
                        rows="16"
                        placeholder="<p>Tulis konten artikel di sini...</p>"
                        class="form-input resize-y font-mono text-sm"
                    ></textarea>
                </div>

                <!-- Action Buttons -->
                <div class="flex gap-4 pt-2">
                    <button
                        type="submit"
                        id="btn-submit"
                        class="flex-1 flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-teal-600 hover:bg-teal-500 text-white font-semibold text-base transition-all duration-200 hover:shadow-lg hover:shadow-teal-500/25 disabled:opacity-50 disabled:cursor-not-allowed"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="w-5 h-5"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M12 4v16m8-8H4"></path>
                        </svg>
                        <span id="btn-submit-text">Publikasikan Artikel</span>
                    </button>
                    <a
                        href="/artikel"
                        class="px-6 py-3.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-600 font-semibold text-base transition-colors"
                    >
                        Batal
                    </a>
                </div>
            </form>
        </div>
    </div>
</Layout>

<style>
    @reference "../../styles/global.css";
    .form-group {
        @apply flex flex-col gap-2;
    }
    .form-label {
        @apply text-sm font-semibold text-slate-700;
    }
    .form-input {
        @apply w-full px-4 py-3 rounded-xl bg-white border border-slate-300 text-slate-900 placeholder-slate-400
               focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent
               transition-all duration-200;
    }
    .form-hint {
        @apply text-xs text-slate-500;
    }
    .form-input.error {
        @apply border-red-500/70 focus:ring-red-500;
    }
    .html-tag-btn {
        @apply px-2.5 py-1 text-[10px] font-bold rounded bg-slate-100 text-slate-600 border border-slate-200
               hover:bg-teal-600 hover:text-white hover:border-teal-500 transition-all active:scale-95;
    }
    .tag-pill {
        @apply inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-teal-50 border border-teal-200
               text-teal-700 text-xs font-medium;
    }
</style>

<script>
    const titleInput = document.getElementById("title") as HTMLInputElement;
    const titleCount = document.getElementById("title-count");
    const excerptEl = document.getElementById("excerpt") as HTMLTextAreaElement;
    const excerptCount = document.getElementById("excerpt-count");
    const imgInput = document.getElementById("image") as HTMLInputElement;
    const uploadZone = document.getElementById("upload-zone");
    const dropUi = document.getElementById("drop-ui");
    const imgPreview = document.getElementById("img-preview");
    const imgPreviewSrc = document.getElementById(
        "img-preview-src",
    ) as HTMLImageElement;
    const btnRemoveImg = document.getElementById("btn-remove-img");
    const form = document.getElementById(
        "create-artikel-form",
    ) as HTMLFormElement;
    const alertEl = document.getElementById("form-alert");
    const submitBtn = document.getElementById(
        "btn-submit",
    ) as HTMLButtonElement;
    const submitText = document.getElementById("btn-submit-text");

    // ── Slug helpers ──────────────────────────────────────────────────────────
    function toSlug(str: string): string {
        return str
            .toLowerCase()
            .normalize("NFD")
            .replace(/[\u0300-\u036f]/g, "")
            .replace(/[^a-z0-9\s-]/g, "")
            .trim()
            .replace(/\s+/g, "-")
            .replace(/-+/g, "-");
    }

    // ── Character counters ────────────────────────────────────────────────────
    titleInput?.addEventListener("input", () => {
        if (titleCount)
            titleCount.textContent = String(titleInput.value.length);
    });
    excerptEl?.addEventListener("input", () => {
        if (excerptCount)
            excerptCount.textContent = String(excerptEl.value.length);
    });

    // ── Image Upload ──────────────────────────────────────────────────────────
    let selectedFile: File | null = null;
    let previewUrl: string | null = null;

    function showPreview(file: File) {
        selectedFile = file;
        if (previewUrl) URL.revokeObjectURL(previewUrl);
        previewUrl = URL.createObjectURL(file);
        if (imgPreviewSrc) imgPreviewSrc.src = previewUrl;
        dropUi?.classList.add("opacity-40");
        imgPreview?.classList.remove("hidden");
    }

    function clearPreview() {
        selectedFile = null;
        if (previewUrl) URL.revokeObjectURL(previewUrl);
        previewUrl = null;
        if (imgPreviewSrc) imgPreviewSrc.src = "";
        if (imgInput) imgInput.value = "";
        dropUi?.classList.remove("opacity-40");
        imgPreview?.classList.add("hidden");
    }

    imgInput?.addEventListener("change", (e) => {
        const files = (e.target as HTMLInputElement).files;
        if (files && files[0]) showPreview(files[0]);
        imgInput.value = "";
    });

    uploadZone?.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        if (target.id === "btn-remove-img" || target.closest("#btn-remove-img"))
            return;
        if (!selectedFile) imgInput?.click();
    });

    btnRemoveImg?.addEventListener("click", (e) => {
        e.stopPropagation();
        clearPreview();
    });

    // Drag & drop
    uploadZone?.addEventListener("dragover", (e) => {
        e.preventDefault();
        dropUi?.classList.add("!border-indigo-500/60", "!bg-slate-900/70");
    });
    uploadZone?.addEventListener("dragleave", () => {
        dropUi?.classList.remove("!border-indigo-500/60", "!bg-slate-900/70");
    });
    uploadZone?.addEventListener("drop", (e) => {
        e.preventDefault();
        dropUi?.classList.remove("!border-indigo-500/60", "!bg-slate-900/70");
        const files = (e as DragEvent).dataTransfer?.files;
        if (files && files[0] && files[0].type.startsWith("image/")) {
            showPreview(files[0]);
        }
    });

    // ── Tags Input ────────────────────────────────────────────────────────────
    const tagsInputEl = document.getElementById(
        "tags-input",
    ) as HTMLInputElement;
    const tagsHidden = document.getElementById(
        "tags-hidden",
    ) as HTMLInputElement;
    const tagsPills = document.getElementById("tags-pills");
    let tags: string[] = [];

    function renderTags() {
        if (!tagsPills) return;
        tagsPills.innerHTML = "";
        tags.forEach((tag, idx) => {
            const pill = document.createElement("span");
            pill.className = "tag-pill";
            pill.innerHTML = `${tag}<button type="button" class="ml-1 opacity-60 hover:opacity-100 font-bold" data-idx="${idx}">×</button>`;
            pill.querySelector("button")?.addEventListener("click", () => {
                tags.splice(idx, 1);
                renderTags();
            });
            tagsPills.appendChild(pill);
        });
        if (tagsHidden) tagsHidden.value = JSON.stringify(tags);
    }

    tagsInputEl?.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === ",") {
            e.preventDefault();
            const val = tagsInputEl.value.trim().replace(/,/g, "");
            if (val && !tags.includes(val) && tags.length < 10) {
                tags.push(val);
                renderTags();
            }
            tagsInputEl.value = "";
        }
    });

    // ── Alert ─────────────────────────────────────────────────────────────────
    function showAlert(msg: string, type: "success" | "error") {
        if (!alertEl) return;
        alertEl.textContent = msg;
        alertEl.className =
            type === "success"
                ? "mb-6 p-4 rounded-xl text-sm font-medium bg-emerald-500/10 border border-emerald-500/30 text-emerald-400"
                : "mb-6 p-4 rounded-xl text-sm font-medium bg-red-500/10 border border-red-500/30 text-red-400";
        alertEl.scrollIntoView({ behavior: "smooth", block: "nearest" });
    }

    // ── Submit ────────────────────────────────────────────────────────────────
    form?.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (!alertEl) return;
        alertEl.className = "hidden mb-6 p-4 rounded-xl text-sm font-medium";

        const raw = new FormData(form);
        const title = (raw.get("title") as string).trim();
        const slug = toSlug(title);

        if (!title) {
            showAlert("Judul wajib diisi.", "error");
            titleInput.focus();
            return;
        }
        if (!selectedFile) {
            showAlert("Gambar thumbnail artikel wajib diupload.", "error");
            return;
        }

        submitBtn.disabled = true;
        if (submitText) submitText.textContent = "Menyimpan...";

        // Build FormData
        const payload = new FormData();
        payload.append("slug", slug);
        payload.append("title", title);
        payload.append("excerpt", (raw.get("excerpt") as string).trim());
        payload.append("category", (raw.get("category") as string).trim());
        payload.append("author", (raw.get("author") as string).trim());
        payload.append(
            "readingTime",
            (raw.get("readingTime") as string).trim(),
        );
        payload.append("content", (raw.get("content") as string).trim());
        payload.append("tags", JSON.stringify(tags));
        payload.append("isPublished", "true");
        payload.append("image", selectedFile);

        try {
            const res = await fetch("/api/artikel", {
                method: "POST",
                body: payload,
            });
            const result = await res.json();

            if (result.success) {
                showAlert("✓ Artikel berhasil dipublikasikan!", "success");
                form.reset();
                clearPreview();
                tags = [];
                renderTags();
                if (titleCount) titleCount.textContent = "0";
                if (excerptCount) excerptCount.textContent = "0";
                setTimeout(() => {
                    window.location.href = "/artikel";
                }, 1500);
            } else {
                showAlert(result.error ?? "Gagal menyimpan artikel.", "error");
            }
        } catch {
            showAlert("Terjadi kesalahan jaringan. Coba lagi.", "error");
        } finally {
            submitBtn.disabled = false;
            if (submitText) submitText.textContent = "Publikasikan Artikel";
        }
    });

    // ── Content Tag Shortcuts ─────────────────────────────────────────────────
    const contentTextarea = document.getElementById(
        "content",
    ) as HTMLTextAreaElement;
    const tagButtons = document.querySelectorAll(".html-tag-btn");

    tagButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
            const tag = (btn as HTMLElement).dataset.tag;
            if (!tag || !contentTextarea) return;

            const start = contentTextarea.selectionStart;
            const end = contentTextarea.selectionEnd;
            const text = contentTextarea.value;
            const selectedText = text.substring(start, end);

            let insertion = "";
            let newCursorPos = start;

            if (tag === "br" || tag === "hr") {
                insertion = tag === "br" ? "<br>\n" : "<hr>\n";
                newCursorPos = start + insertion.length;
            } else if (tag === "a") {
                const url = prompt("Masukkan URL link:", "https://");
                if (url === null) return;
                insertion = `<a href="${url}" target="_blank" class="text-indigo-400 hover:underline">${selectedText || "link"}</a>`;
                newCursorPos = start + insertion.length;
            } else if (tag === "ul") {
                insertion = `<ul>\n  <li>${selectedText || "Item 1"}</li>\n  <li>Item 2</li>\n</ul>\n`;
                newCursorPos = start + insertion.length;
            } else if (tag === "ol") {
                insertion = `<ol>\n  <li>${selectedText || "Item 1"}</li>\n  <li>Item 2</li>\n</ol>\n`;
                newCursorPos = start + insertion.length;
            } else if (tag === "p") {
                insertion = `<p>${selectedText}</p>\n`;
                newCursorPos = start + insertion.length;
            } else if (tag === "blockquote") {
                insertion = `<blockquote class="border-l-4 border-indigo-500 pl-4 italic text-slate-400">${selectedText || "Tulis kutipan di sini..."}</blockquote>\n`;
                newCursorPos = start + insertion.length;
            } else {
                insertion = `<${tag}>${selectedText}</${tag}>`;
                newCursorPos = start + tag.length + 2 + selectedText.length;
            }

            contentTextarea.value =
                text.substring(0, start) + insertion + text.substring(end);

            contentTextarea.focus();
            contentTextarea.setSelectionRange(newCursorPos, newCursorPos);
            contentTextarea.dispatchEvent(new Event("input"));
        });
    });

    // Clear error class on re-input
    document
        .querySelectorAll<
            HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement
        >(".form-input")
        .forEach((el) => {
            el.addEventListener("input", () => el.classList.remove("error"));
            el.addEventListener("change", () => el.classList.remove("error"));
        });
</script>
