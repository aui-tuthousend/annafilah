---
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/home/HeroSection.astro";
import AboutSection from "../components/home/AboutSection.astro";
import NewsCarousel from "./berita/-components/NewsCarousel.astro";
import PartnerLogos from "../components/home/PartnerLogos.astro";
import ArtikelCarousel from "./artikel/-components/ArtikelCarousel.astro";

export const prerender = false;
---

<Layout
  title="Yayasan Annafilah"
  description="Annafilah hadir sebagai mitra bisnis terpercaya Anda. Kami menyediakan layanan konsultasi, pengembangan digital, dan solusi inovatif untuk pertumbuhan perusahaan Anda."
>
  <HeroSection />
  <AboutSection />
  <NewsCarousel />
  <ArtikelCarousel />
  <PartnerLogos />

  <section class="bg-slate-950 border-t border-white/5 p-10">
    <img
      src="/qr.jpeg"
      alt="QR Code Donasi"
      class="w-full h-auto object-cover"
    />
  </section>
</Layout>
