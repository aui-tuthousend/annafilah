---
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/home/HeroSection.astro";
import AboutSection from "../components/home/AboutSection.astro";
import VideoSection from "../components/home/VideoSection.astro";
import NewsCarousel from "./berita/_components/NewsCarousel.astro";
import PartnerLogos from "../components/home/PartnerLogos.astro";
import ArtikelCarousel from "./artikel/_components/ArtikelCarousel.astro";

export const prerender = false;

// Structured data: profil organisasi untuk hasil pencarian Google
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "NGO",
  name: "Yayasan Annafilah",
  url: "https://annafilah.id",
  logo: "https://annafilah.id/logo.webp",
  email: "yayasanannafilah@gmail.com",
  telephone: "+62 812-3434-4229",
  address: {
    "@type": "PostalAddress",
    streetAddress:
      "Jl. Pagesangan II A Townhouse No.2, Pagesangan, Kec. Jambangan",
    addressLocality: "Surabaya",
    addressRegion: "Jawa Timur",
    postalCode: "60233",
    addressCountry: "ID",
  },
};
---

<Layout
  title="Yayasan Annafilah - Lembaga Pendidikan & Sosial Surabaya"
  description="Berdiri sejak 2011, Yayasan Annafilah merupakan lembaga pendidikan dan sosial yang berkomitmen mensinergikan pendidikan Al-Qur'an dengan aksi kepedulian sosial yang nyata bagi masyarakat."
  structuredData={organizationSchema}
>
  <HeroSection />
  <AboutSection />
  <VideoSection />
  <NewsCarousel />
  <ArtikelCarousel />
  <PartnerLogos />

  <section class="bg-slate-50 border-t border-slate-200 p-10">
    <img
      src="/qr.jpeg"
      alt="QR Code Donasi"
      class="w-full h-auto object-cover"
    />
  </section>
</Layout>
