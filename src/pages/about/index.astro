---
import Layout from "../../layouts/Layout.astro";

const team = [
  {
    name: "Nur Endah",
    role: "Founder",
    bio: "Berdedikasi dalam merumuskan arah serta program-program utama yayasan untuk kemaslahatan umat.",
    avatar: "NE",
    color: "from-teal-500 to-emerald-600",
  },
  {
    name: "Latifah Mufrida",
    role: "Ketua Yayasan",
    bio: "Mengelola administrasi, komunikasi, dan tertib operasional harian Yayasan Annafilah.",
    avatar: "LM",
    color: "from-violet-500 to-purple-600",
  },
  {
    name: "Haniah Trihapsari",
    role: "Wakil Ketua Yayasan",
    bio: "Bertanggung jawab atas pengelolaan dana, transparansi keuangan, dan penyaluran donasi.",
    avatar: "HT",
    color: "from-sky-500 to-teal-600",
  },
  {
    name: "Nuri Masyita",
    role: "Kepala Pendidik",
    bio: "Fokus pada pengembangan kurikulum Tahfidz dan pembinaan karakter luhur para santri.",
    avatar: "NM",
    color: "from-pink-500 to-rose-600",
  },
];

const milestones = [
  { year: "2011", event: "Yayasan Annafilah mulai dirintis dengan komitmen dakwah dan pendidikan Al-Qur'an." },
  { year: "2015", event: "Menguatkan program pengajaran untuk mendidik generasi berkarakter Islami." },
  { year: "2018", event: "Memperluas jangkauan operasional dengan program bantuan sosial bagi masyarakat sekitar." },
  { year: "2021", event: "Terus menebar manfaat dan bantuan aktif di tengah kondisi menantang pandemi." },
  { year: "2024", event: "Menjangkau semakin banyak penerima manfaat dan mengukuhkan program pendidikan." },
];
---

<Layout
  title="Tentang Kami"
  description="Mengenal lebih dalam dengan para pengurus dan perjalanan Yayasan Annafilah sebagai lembaga pendidikan dan sosial."
>
  <!-- Hero -->
  <section class="relative pt-32 pb-20 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-slate-50 via-teal-50/20 to-slate-50 pointer-events-none"></div>
    <div class="absolute top-20 right-0 w-96 h-96 bg-teal-400/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative max-w-7xl mx-auto px-6">
      <div class="max-w-3xl">
        <p class="text-teal-600 font-semibold text-sm uppercase tracking-widest mb-4">Tentang Kami</p>
        <h1 class="text-5xl md:text-6xl font-extrabold text-slate-900 leading-tight mb-6">
          Mencetak Generasi Qur'ani yang
          <span class="bg-gradient-to-r from-teal-500 to-emerald-500 bg-clip-text text-transparent">
            Berkarakter & Peduli
          </span>
        </h1>
        <p class="text-xl text-slate-600 leading-relaxed">
          Sejak 2011, Yayasan Annafilah hadir sebagai lembaga pendidikan dan sosial yang berkhidmat untuk melahirkan generasi penghafal Al-Qur'an dan memberikan dampak positif bagi umat.
        </p>
      </div>
    </div>
  </section>

  <!-- Misi & Visi -->
  <section class="py-20 max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="p-8 rounded-2xl border border-teal-200 bg-teal-50">
        <div class="w-12 h-12 rounded-xl bg-teal-100 flex items-center justify-center text-2xl mb-6">🎯</div>
        <h2 class="text-2xl font-bold text-slate-900 mb-4">Misi</h2>
        <p class="text-slate-600 leading-relaxed">
          Menyelenggarakan pendidikan Al-Qur'an yang berkualitas, membina akhlak mulia, serta melaksanakan program pemberdayaan dan kepedulian sosial bagi kemaslahatan masyarakat.
        </p>
      </div>
      <div class="p-8 rounded-2xl border border-violet-200 bg-violet-50">
        <div class="w-12 h-12 rounded-xl bg-violet-100 flex items-center justify-center text-2xl mb-6">🔭</div>
        <h2 class="text-2xl font-bold text-slate-900 mb-4">Visi</h2>
        <p class="text-slate-600 leading-relaxed">
          Menjadi institusi sosial dan pendidikan terdepan yang melahirkan para penghafal Al-Qur'an yang mandiri, berkarakter luhur, serta bermanfaat luas bagi masyarakat dan bangsa.
        </p>
      </div>
    </div>
  </section>

  <!-- Timeline -->
  <section class="py-20 bg-slate-100">
    <div class="max-w-4xl mx-auto px-6">
      <div class="text-center mb-16">
        <p class="text-teal-600 font-semibold text-sm uppercase tracking-widest mb-3">Perjalanan Kami</p>
        <h2 class="text-4xl font-extrabold text-slate-900">Jejak Langkah</h2>
      </div>
      <div class="relative">
        <!-- Garis vertikal -->
        <div class="absolute left-6 md:left-1/2 top-0 bottom-0 w-px bg-white/10 -translate-x-0.5"></div>

        <div class="space-y-12">
          {milestones.map((item, i) => (
            <div class={`relative flex items-start gap-8 ${i % 2 === 0 ? "md:flex-row" : "md:flex-row-reverse"}`}>
              <!-- Dot -->
              <div class="absolute left-4 md:left-1/2 w-4 h-4 rounded-full bg-teal-500 border-4 border-slate-50 -translate-x-1.5 mt-1"></div>
              <!-- Content -->
              <div class={`pl-16 md:pl-0 md:w-1/2 ${i % 2 === 0 ? "md:pr-12 md:text-right" : "md:pl-12"}`}>
                <span class="inline-block px-3 py-1 rounded-full bg-teal-50 border border-teal-200 text-teal-700 text-sm font-bold mb-3">
                  {item.year}
                </span>
                <p class="text-slate-600 leading-relaxed">{item.event}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Tim -->
  <section class="py-24 max-w-7xl mx-auto px-6">
    <div class="text-center mb-16">
      <p class="text-teal-600 font-semibold text-sm uppercase tracking-widest mb-3">Pengurus Kami</p>
      <h2 class="text-4xl font-extrabold text-slate-900">Mengenal Tim Kami</h2>
      <p class="text-slate-500 mt-4 max-w-xl mx-auto">
        Tim pengurus kami berdedikasi penuh untuk kemajuan yayasan, kelancaran pendidikan dakwah, serta mendampingi para santri mencapai cita-cita.
      </p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {team.map((member) => (
        <div class="group p-6 rounded-2xl border border-slate-200 bg-white hover:border-teal-200 hover:bg-slate-50 transition-all duration-300 text-center shadow-sm">
          <div class={`w-20 h-20 rounded-2xl bg-gradient-to-br ${member.color} flex items-center justify-center text-white text-2xl font-extrabold mx-auto mb-5 group-hover:scale-105 transition-transform`}>
            {member.avatar}
          </div>
          <h3 class="font-bold text-slate-900 text-lg">{member.name}</h3>
          <p class="text-teal-600 text-sm font-medium mt-1 mb-3">{member.role}</p>
          <p class="text-slate-500 text-sm leading-relaxed">{member.bio}</p>
        </div>
      ))}
    </div>
  </section>
</Layout>
