---
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";

const layananList = [
    {
        slug: "konsultasi-bisnis",
        icon: "🚀",
        title: "Konsultasi Bisnis",
        description:
            "Strategi bisnis tepat sasaran untuk pertumbuhan jangka panjang.",
        duration: "1–3 bulan",
        color: "indigo",
    },
    {
        slug: "pengembangan-digital",
        icon: "💡",
        title: "Pengembangan Digital",
        description: "Solusi web, mobile, dan integrasi sistem end-to-end.",
        duration: "2–6 bulan",
        color: "violet",
    },
    {
        slug: "analitik-laporan",
        icon: "📊",
        title: "Analitik & Laporan",
        description: "Dashboard dan insight data untuk keputusan lebih cerdas.",
        duration: "1–2 bulan",
        color: "sky",
    },
];

const colorBorder: Record<string, string> = {
    indigo: "hover:border-indigo-500/40",
    violet: "hover:border-violet-500/40",
    sky: "hover:border-sky-500/40",
};
---

<Layout
    title="Layanan – Annafilah"
    description="Temukan layanan Annafilah yang tepat untuk kebutuhan bisnis Anda."
>
    <section class="pt-32 pb-24 max-w-7xl mx-auto px-6">
        <div class="text-center mb-16">
            <p
                class="text-indigo-400 font-semibold text-sm uppercase tracking-widest mb-3"
            >
                Apa yang Kami Tawarkan
            </p>
            <h1 class="text-5xl font-extrabold text-white mb-4">
                Semua Layanan
            </h1>
            <p class="text-slate-400 text-lg max-w-xl mx-auto">
                Pilih layanan yang sesuai dengan tahap dan kebutuhan bisnis Anda
                saat ini.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {
                layananList.map((item) => (
                    <a
                        href={`/layanan/${item.slug}`}
                        class={`group p-8 rounded-2xl border border-white/5 bg-white/2 ${colorBorder[item.color]} hover:bg-white/5 transition-all duration-300 block`}
                    >
                        <div class="text-4xl mb-5 group-hover:scale-110 transition-transform inline-block">
                            {item.icon}
                        </div>
                        <h2 class="text-xl font-bold text-white mb-3">
                            {item.title}
                        </h2>
                        <p class="text-slate-400 text-sm leading-relaxed mb-6">
                            {item.description}
                        </p>
                        <div class="flex items-center justify-between text-sm">
                            <span class="text-slate-500">
                                ⏱ {item.duration}
                            </span>
                            <span class="text-indigo-400 font-medium group-hover:translate-x-1 transition-transform inline-block">
                                Detail →
                            </span>
                        </div>
                    </a>
                ))
            }
        </div>
    </section>
</Layout>
