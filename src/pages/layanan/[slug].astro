---
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";

// ─── Static data (fallback jika DB belum ada) ───────────────────────────────
// Di production, ini bisa diambil dari DB via Drizzle
const allLayanan = [
    {
        slug: "konsultasi-bisnis",
        icon: "🚀",
        title: "Konsultasi Bisnis",
        tagline: "Strategi yang tepat untuk pertumbuhan yang berkelanjutan",
        description:
            "Kami membantu Anda merancang roadmap bisnis yang realistis dan terukur. Mulai dari analisis pasar, competitive intelligence, hingga perencanaan ekspansi.",
        features: [
            "Analisis SWOT mendalam",
            "Business model canvas",
            "Competitive intelligence",
            "Financial projection 3–5 tahun",
            "Go-to-market strategy",
        ],
        duration: "1–3 bulan",
        price: "Mulai Rp 15 juta",
        color: "indigo",
    },
    {
        slug: "pengembangan-digital",
        icon: "💡",
        title: "Pengembangan Digital",
        tagline: "Teknologi modern untuk transformasi bisnis Anda",
        description:
            "Solusi end-to-end dari desain UI/UX, pengembangan web dan mobile, hingga integrasi sistem yang memastikan bisnis Anda siap di era digital.",
        features: [
            "Web & mobile app development",
            "UI/UX design & prototyping",
            "API integration & microservices",
            "Cloud infrastructure (AWS/GCP)",
            "DevOps & CI/CD pipeline",
        ],
        duration: "2–6 bulan",
        price: "Mulai Rp 50 juta",
        color: "violet",
    },
    {
        slug: "analitik-laporan",
        icon: "📊",
        title: "Analitik & Laporan",
        tagline: "Data-driven insights untuk keputusan yang lebih cerdas",
        description:
            "Ubah data mentah menjadi insight yang actionable. Kami membangun dashboard realtime, laporan otomatis, dan model prediktif untuk bisnis Anda.",
        features: [
            "Business intelligence dashboard",
            "Automated reporting",
            "Predictive analytics",
            "Data warehouse setup",
            "KPI tracking system",
        ],
        duration: "1–2 bulan",
        price: "Mulai Rp 20 juta",
        color: "sky",
    },
];

// ─────────────────────────────────────────────────────────────────────────────
// KONSEP ROUTING ASTRO – DYNAMIC ROUTES
// ─────────────────────────────────────────────────────────────────────────────
//
// File ini berada di: src/pages/layanan/[slug].astro
// URL yang dihasilkan: /layanan/konsultasi-bisnis
//                      /layanan/pengembangan-digital
//                      /layanan/analitik-laporan
//
// Karena mode output default adalah "static", Astro WAJIB tahu daftar semua
// slug saat build time → gunakan `getStaticPaths()`.
//
// Jika pakai `export const prerender = false`, halaman dirender server-side
// dan `getStaticPaths()` tidak diperlukan (bisa ambil slug dari URL langsung).
// ─────────────────────────────────────────────────────────────────────────────

export async function getStaticPaths() {
    // Bisa diganti dengan query DB:
    // const layananList = await db.select().from(services);
    // return layananList.map(l => ({ params: { slug: l.slug } }));

    return allLayanan.map((item) => ({
        params: { slug: item.slug },
        props: { layanan: item }, // <-- props diteruskan ke halaman
    }));
}

// Ambil props dari getStaticPaths
const { layanan } = Astro.props;

// Warna per layanan
const colorMap: Record<string, string> = {
    indigo: "from-indigo-500 to-violet-600",
    violet: "from-violet-500 to-purple-600",
    sky: "from-sky-500 to-indigo-600",
};
const gradient = colorMap[layanan.color] ?? colorMap["indigo"];
---

<Layout title={`${layanan.title} – Annafilah`} description={layanan.tagline}>
    <!-- Breadcrumb -->
    <div class="pt-24 pb-4 max-w-7xl mx-auto px-6">
        <nav
            class="flex items-center gap-2 text-sm text-slate-500"
            aria-label="Breadcrumb"
        >
            <a href="/" class="hover:text-slate-300 transition-colors"
                >Beranda</a
            >
            <span>/</span>
            <a href="/layanan" class="hover:text-slate-300 transition-colors"
                >Layanan</a
            >
            <span>/</span>
            <span class="text-slate-300">{layanan.title}</span>
        </nav>
    </div>

    <!-- Hero -->
    <section class="relative pb-20 overflow-hidden">
        <div
            class="absolute inset-0 bg-gradient-to-b from-indigo-950/20 to-transparent pointer-events-none"
        >
        </div>

        <div class="relative max-w-4xl mx-auto px-6 text-center pt-12">
            <div
                class={`w-20 h-20 rounded-2xl bg-gradient-to-br ${gradient} flex items-center justify-center text-4xl mx-auto mb-8 shadow-lg`}
            >
                {layanan.icon}
            </div>
            <h1 class="text-5xl md:text-6xl font-extrabold text-white mb-4">
                {layanan.title}
            </h1>
            <p class="text-xl text-slate-300 leading-relaxed max-w-2xl mx-auto">
                {layanan.tagline}
            </p>
        </div>
    </section>

    <!-- Detail -->
    <section class="py-16 max-w-5xl mx-auto px-6">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- Deskripsi & Fitur -->
            <div class="lg:col-span-2 space-y-8">
                <div class="p-8 rounded-2xl border border-white/5 bg-white/2">
                    <h2 class="text-2xl font-bold text-white mb-4">
                        Tentang Layanan
                    </h2>
                    <p class="text-slate-300 leading-relaxed text-lg">
                        {layanan.description}
                    </p>
                </div>
                <div class="p-8 rounded-2xl border border-white/5 bg-white/2">
                    <h2 class="text-2xl font-bold text-white mb-6">
                        Yang Anda Dapatkan
                    </h2>
                    <ul class="space-y-4">
                        {
                            layanan.features.map((f) => (
                                <li class="flex items-start gap-3 text-slate-300">
                                    <span class="w-5 h-5 rounded-full bg-indigo-500/20 border border-indigo-500/40 flex items-center justify-center text-indigo-400 text-xs font-bold flex-shrink-0 mt-0.5">
                                        ✓
                                    </span>
                                    {f}
                                </li>
                            ))
                        }
                    </ul>
                </div>
            </div>

            <!-- Info Card -->
            <div class="space-y-6">
                <div
                    class="p-6 rounded-2xl border border-white/10 bg-white/3 space-y-6 sticky top-24"
                >
                    <div>
                        <p
                            class="text-xs text-slate-500 uppercase tracking-widest mb-1"
                        >
                            Estimasi Waktu
                        </p>
                        <p class="text-white font-semibold text-lg">
                            {layanan.duration}
                        </p>
                    </div>
                    <div>
                        <p
                            class="text-xs text-slate-500 uppercase tracking-widest mb-1"
                        >
                            Investasi
                        </p>
                        <p class="text-white font-semibold text-lg">
                            {layanan.price}
                        </p>
                    </div>
                    <div class="border-t border-white/5 pt-6">
                        <a
                            href="/#contact"
                            class="block w-full py-3.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-center transition-all duration-200 hover:shadow-lg hover:shadow-indigo-500/25"
                        >
                            Konsultasi Gratis →
                        </a>
                        <a
                            href="/layanan"
                            class="block w-full py-3 mt-3 rounded-xl border border-white/10 hover:border-white/20 text-slate-300 hover:text-white font-medium text-center transition-colors text-sm"
                        >
                            ← Lihat Semua Layanan
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
</Layout>
