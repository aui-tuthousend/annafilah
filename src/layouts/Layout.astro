---
import "../styles/global.css";

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = "Annafilah – Solusi profesional untuk kebutuhan bisnis Anda. Kami hadir dengan layanan terpercaya, inovatif, dan berkualitas.",
  ogImage = "/og-image.png",
} = Astro.props;

const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site ?? Astro.url.origin,
);

// Cek session via Astro.locals yang diisi oleh middleware (Hemat Database Query)
const currentUser = Astro.locals.username
  ? { username: Astro.locals.username }
  : null;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="font-[Inter,sans-serif]">
    <!-- Navbar -->
    <!-- Navbar (DaisyUI) -->
    <header class="fixed top-0 left-0 right-0 z-50">
      <div
        class="navbar bg-slate-950/80 backdrop-blur-md border-b border-white/5 px-6 md:px-12 w-full"
      >
        <div class="navbar-start">
          <div class="dropdown">
            <div
              tabindex="0"
              role="button"
              class="btn btn-ghost lg:hidden text-white"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4 6h16M4 12h8m-8 6h16"></path>
              </svg>
            </div>
            <ul
              tabindex="0"
              class="menu menu-sm dropdown-content bg-slate-900 rounded-box z-1 mt-3 w-52 p-2 shadow border border-white/10 text-slate-300"
            >
              <li><a href="/about" class="hover:text-white">Tentang</a></li>
              <li><a href="/berita" class="hover:text-white">Berita</a></li>
              <li><a href="/artikel" class="hover:text-white">Artikel</a></li>
              <li><a href="/program" class="hover:text-white">Program</a></li>
            </ul>
          </div>
          <a
            href="/"
            class="flex items-center gap-2 font-extrabold text-xl text-white tracking-tight"
          >
            <img
              src="/logo.webp"
              alt="Annafilah Logo"
              class="w-30 h-10 object-contain"
            />
          </a>
        </div>
        <div class="navbar-center hidden lg:flex">
          <ul class="menu menu-horizontal px-1 text-slate-300 font-medium">
            <li>
              <a href="/about" class="hover:text-white transition-colors"
                >Profil</a
              >
            </li>
            <li>
              <a href="/berita" class="hover:text-white transition-colors"
                >Berita</a
              >
            </li>
            <li>
              <a href="/artikel" class="hover:text-white transition-colors"
                >Artikel</a
              >
            </li>
            <li>
              <a href="/program" class="hover:text-white transition-colors"
                >Program</a
              >
            </li>
          </ul>
        </div>
        <div class="navbar-end gap-2">
          {
            currentUser ? (
              // ── Admin sedang login ───────────────────────────────────────────
              <div class="flex items-center gap-3">
                <div class="hidden md:flex items-center gap-2 px-3 py-1.5 rounded-lg bg-indigo-600/20 border border-indigo-500/30">
                  <div class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse" />
                  <span class="text-indigo-300 text-xs font-semibold">
                    {currentUser.username}
                  </span>
                </div>
                <form method="POST" action="/api/auth/logout">
                  <button
                    type="submit"
                    class="btn btn-ghost btn-sm text-slate-400 hover:text-white hover:bg-red-500/20 border border-white/10 hover:border-red-500/40 transition-all"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="w-4 h-4"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
                      />
                    </svg>
                    <span class="hidden md:inline">Logout</span>
                  </button>
                </form>
              </div>
            ) : (
              // ── Belum login ──────────────────────────────────────────────────
              <a
                href="#contact"
                class="btn bg-indigo-600 hover:bg-indigo-500 border-none text-white btn-sm md:btn-md"
              >
                Hubungi Kami
              </a>
            )
          }
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-slate-900 border-t border-white/5 mt-10">
      <div class="max-w-7xl mx-auto px-6 py-16">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
          <div>
            <div
              class="flex items-center gap-2 font-extrabold text-xl text-white mb-4"
            >
              <img
                src="/logo.webp"
                alt="Annafilah Logo"
                class="w-30 h-10 object-contain"
              />
            </div>
            <p class="text-slate-400 text-sm leading-relaxed">
              Solusi profesional untuk kebutuhan bisnis Anda. Kami hadir dengan
              layanan terpercaya, inovatif, dan berkualitas.
            </p>
          </div>
          <div>
            <h3 class="font-semibold text-white mb-4">Navigasi</h3>
            <ul class="space-y-2 text-sm text-slate-400">
              <li>
                <a href="#services" class="hover:text-white transition-colors"
                  >Layanan</a
                >
              </li>
              <li>
                <a href="#about" class="hover:text-white transition-colors"
                  >Tentang Kami</a
                >
              </li>
              <li>
                <a href="#contact" class="hover:text-white transition-colors"
                  >Kontak</a
                >
              </li>
            </ul>
          </div>
          <div>
            <h3 class="font-semibold text-white mb-4">Kontak</h3>
            <ul class="space-y-2 text-sm text-slate-400">
              <li>📧 hello@annafilah.id</li>
              <li>📞 +62 812-3456-7890</li>
              <li>📍 Jakarta, Indonesia</li>
            </ul>
          </div>
        </div>
        <div
          class="border-t border-white/5 mt-12 pt-8 text-center text-sm text-slate-500"
        >
          <p>
            © {new Date().getFullYear()} Annafilah. Seluruh hak cipta dilindungi.
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
